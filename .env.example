# ──────────────────────────────────────────────────────────────
# Cosmos Pay — Developer Platform
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection used by Prisma (accounts / orgs / profiles — own DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosmos_devplatform?schema=public

# ── Auth (Better Auth) ──
BETTER_AUTH_SECRET=supersecret
BETTER_AUTH_URL=http://localhost:4321
# Same value as BETTER_AUTH_URL, exposed to the browser bundle (keep in sync).
# In production set both to the public domain, e.g. https://dev.cosmospay.lat
PUBLIC_BETTER_AUTH_URL=http://localhost:4321

# ── Authentik OAuth2 (external login provider) ──
AUTHENTIK_CLIENT_ID=your-authentik-client-id
AUTHENTIK_CLIENT_SECRET=your-authentik-client-secret
AUTHENTIK_DISCOVERY_URL=http://localhost:9000/application/o/cosmos/.well-known/openid-configuration

# ── Wallets do not call this platform ──
# The wallet's sign-in, its API keys, its emails, SEP-10/SEP-30 recovery, the shared public
# key, the asset catalog and telemetry all live on the community server, reached through
# APISIX. This platform issues developers' keys and shows data; it may be down without any
# wallet noticing. It still MINTS the shared public key: GET /api/admin/public-key (owner/
# admin session), then copy the values into the community server's PUBLIC_API_KEY_DEV/_PROD.

# ── APISIX (admin API: provisions consumers / keys / routes) ──
APISIX_URL=http://127.0.0.1:9180/apisix/admin
APISIX_ADMIN_KEY=apikeyofapisix
APISSIX_ROUTE_ID=cosmos-api-keys

# ── Cosmos Payments API (the community server, proxied via APISIX) ──
# One `host:port`, or a comma-separated list of replicas APISIX balances round-robin.
COSMOS_API_URL=http://localhost:3000
COSMOS_API_ENTRY="/cosmos-api/*"
# Must stay anchored to the entry: the keyless SEP route also serves /.well-known/stellar.toml,
# which has no entry prefix, and the route sync refuses a pattern that would rewrite it.
COSMOS_API_REWRITE=["^/cosmos-api/(.*)","/$1"]
# Optional recovery hosts. Each SEP-30 recovery server is its OWN community-server deployment
# (own database, own keys) on its own host. With BOTH halves of a pair set, the route sync adds
# a keyless route for stellar.toml + /v1/sep10/* + /v1/sep30/*, bound to that HOST (APISIX host
# match) and pointed at that UPSTREAM (comma-separated host:port replicas allowed). Leave a
# pair empty to route nothing for that role; an earlier route for it is removed.
COSMOS_RECOVERY_A_HOST=
COSMOS_RECOVERY_A_UPSTREAM=
COSMOS_RECOVERY_B_HOST=
COSMOS_RECOVERY_B_UPSTREAM=
# REQUIRED. Must equal the community server's APISIX_GATEWAY_SECRET (it always enforces it;
# empty → every Payments API call 403s). `openssl rand -hex 32`.
COSMOS_GATEWAY_SECRET=replace-with-a-long-random-secret
# Browser origins the gateway route answers CORS for, comma-separated. APISIX's cors plugin
# emits `Access-Control-Allow-Origin` ONLY for an origin in this list — anything else gets a
# 200 preflight with no CORS header, which a browser refuses with no useful message.
#
# The wallet is not only a web page, and the shells it also ships as each present their own
# origin with no way to change it:
#   tauri://localhost        Tauri on macOS, Linux and iOS
#   http://tauri.localhost   Tauri on Windows and Android
#   tauri://localhost:3000   requested by the operator; Tauri v2 mints no port, so it grants
#                            nothing on its own — keep it, but never INSTEAD of the two above
# The browser extension is deliberately absent: its origin is `chrome-extension://<id>`, the
# id differs per install, and it needs no entry because the MV3 manifest's host_permissions
# exempt it from CORS entirely.
#   https://cosmospay.github.io  the wallet's GitHub Pages build
#   null                     the MetaMask Snap (Cosmos-Metamask-Adapter): it runs in a sandboxed
#                            iframe, whose Origin is the literal `null`. Sent to APISIX as
#                            allow_origins_by_regex `^null$` (its schema refuses `null` inside a
#                            list). Safe here because no route authenticates by cookie — the key
#                            travels in a header — so a null-origin page reads only what it could
#                            already request with a key it holds.
#
# Takes effect only after `npm run sync:route` pushes the route to APISIX.
COSMOS_API_CORS_ORIGINS=https://cosmospay.lat,https://dev.cosmospay.lat,https://cosmospay.github.io,tauri://localhost,http://tauri.localhost,tauri://localhost:3000,null

# ── Documentation (/docs) ──
# The /docs content (content/docs/{sdk,api} + openapi.json) is GENERATED from the external SDK +
# community-server repos but COMMITTED to this repo, so the build never needs those repos: on a
# box without them, generate-sdk/generate-api skip and the build uses the committed content.
# To refresh the docs, build locally where the repos are (`npm run build`) and commit the updated
# content/docs/{sdk,api} + docs/openapi.json. Production then just builds from that committed content.
# Optional: override where the generators read their sources (defaults are the sibling repos
# ../cosmosjs_sdk/llms + its dist/*.d.ts, and ../comos-pay-community-server/openapi/openapi.json):
SDK_LLMS_DIR=
OPENAPI_SRC=

# ── Email (organization invitations / magic links) ──
# SMTP transport. SMTP_FROM must be a VERIFIED sender. 465 → SMTP_SECURE=true · 587 → false.
# Alternative: to use the Resend HTTP API (works where SMTP ports are blocked), add
# RESEND_API_KEY instead of the SMTP_* vars — it takes priority when set.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM=no-reply@your-verified-domain.com
# The Resend alternative named above. Set it INSTEAD of the SMTP_* pair; it takes priority
# when both are present. SMTP_FROM is still the "from" and must still be a verified sender.
RESEND_API_KEY=

# ── CORS for THIS platform's own API (/api/*) ──
# Extra browser origins, comma-separated, ON TOP of the built-in defaults (cosmospay.lat,
# www./dev. subdomains, localhost, and the wallet's webview origins). Handled by
# src/middleware.ts. Empty = defaults only.
#
# NOT the same as COSMOS_API_CORS_ORIGINS above, and the two are easy to confuse: that one
# is the APISIX route in front of the community server and only takes effect after
# `npm run sync:route`; this one is this app's own middleware and takes effect on restart.
CORS_ALLOWED_ORIGINS=

# ── Feature flags (plans & onboarding) ──
ONBOARDING_ENABLED=true
PLANS_ENABLED=true
ALLOW_USER_PLAN_CHANGES=true
ENABLED_PLANS=

# ── API reference (Swagger) ──
# Exposes the portal's own API reference (Swagger UI at /swagger + the /api/openapi.json spec).
# It's a developer/internal tool: ON automatically in development, OFF in production. Set true to
# also expose it in a specific environment (e.g. staging). Leave empty/false for production.
API_DOCS_ENABLED=false

# ── Analytics ──
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Empty = tracking disabled.
# PUBLIC_ vars are embedded at build time → rebuild after changing this.
PUBLIC_GA_ID=

# ── SEO / Google Search Console ──
# Ownership-verification token. In Search Console pick "HTML tag" and paste ONLY the
# value inside content="…" here (not the whole tag). When set, the verification
# <meta> is rendered on every public page. Empty = no tag. Rebuild after changing
# (PUBLIC_ vars are embedded at build time). Search Console can also verify via the
# PUBLIC_GA_ID property above, or by the /sitemap.xml + /robots.txt already shipped.
PUBLIC_GOOGLE_SITE_VERIFICATION=
