# build output
dist/

# ephemeral GitHub Release body, generated by git-cliff during the release workflow
RELEASE_NOTES.md

# docs static export, copied in by scripts/build-docs.mjs (source lives in docs/)
public/docs/

# merchant embed bundle, built from src/embed by scripts/build-embed.mjs with the
# environment's origins inlined (npm run embed:build; build and predev run it)
/public/embed/cosmos-pay.js

# design handoff bundle (reference only)
.design-ref/

# generated types
.astro/

# Prisma 7 generated client (regenerated by `prisma generate`)
/generated/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# MaxMind GeoLite2 database (large binary; download separately)
data/geoip/*.mmdb

# scripts/export-wallet-data.mjs output: encrypted seed backups + emails. Never commit it.
wallet-data-export*.json


# share cards, drawn from the page registry by scripts/build-og-images.mjs (npm run og:build;
# build, build:app and predev run it) and fingerprinted by Vite under /_astro/
/src/assets/og/
