// Cosmos Pay — Developer Platform
// Own accounts/profile system backing the Authentik (OAuth2) login.
// better-auth persists its core models here; Profile is our own per-user data.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------- better-auth core models ----------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  profile         Profile?
  notifications   Notification[]
  supportMessages SupportMessage[]
  supportTickets  SupportTicket[]
  ownedOrgs       Organization[]       @relation("OrgOwner")
  orgMemberships  OrganizationMember[] @relation("OrgMembership")
  walletBackup    WalletBackup?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------------- Cosmos Pay own profile data ----------------

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  locale      String   @default("EN")
  theme       String   @default("light")

  // Developer-panel account role: "user" (default) | "support" | "admin" | "owner".
  role        String   @default("user")

  // Billing plan (mock — not yet wired to a billing provider): community | starter | growth | enterprise.
  plan        String   @default("community")

  // Defaults captured at account creation.
  region      String?
  country     String?
  language    String   @default("en")

  // Last sign-in location (CDN country header + IP), refreshed per new session.
  lastSessionId   String?
  lastLoginIp     String?
  lastLoginCountry String?
  lastLoginRegion  String?
  lastLoginAt     DateTime?

  // Last activity (any authenticated request), throttled — used for "last online".
  lastSeenAt      DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile")
}

// ---------------- Activity notifications ----------------
// System-generated on actions (api-key create/update/delete, sign-in, …).
// Readable by the owning user; only owner/admin accounts may create them via the API.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String?
  origin    String?
  country   String?
  region    String?
  ipAddress String?
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notification")
}

// ---------------- Support chat ----------------
// One conversation per customer (keyed by `userId`). `fromStaff` distinguishes the
// customer's messages from staff (owner/admin/support) replies. Read flags are tracked
// per side so both the bell badge and the staff inbox can show unread counts.
// A support ticket: an individual conversation thread owned by a customer, with its own
// subject and status. A customer can have several tickets open in parallel.
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String // the customer who owns the ticket
  subject   String
  status    String   @default("open") // open | pending | resolved | closed
  priority  String   @default("normal") // low | normal | high | urgent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status])
  @@map("support_ticket")
}

model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String // the ticket this message belongs to
  userId      String // ticket owner (the customer) — denormalized for convenience
  senderId    String // user id of whoever sent this message
  senderName  String?
  fromStaff   Boolean  @default(false)
  body          String
  readByUser    Boolean   @default(false)
  readByStaff   Boolean   @default(false)
  readByUserAt  DateTime? // when the customer read this (for staff messages)
  readByStaffAt DateTime? // when staff read this (for customer messages)
  createdAt     DateTime  @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([userId, createdAt])
  @@map("support_message")
}

// ---------------- Organizations ----------------
// A workspace owned by a user; members join via OrganizationMember with an org-level role.
model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  // Onboarding context (industry, goals, expected volume) — optional, captured on creation.
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User                     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     OrganizationMember[]
  invitations OrganizationInvitation[]

  @@index([ownerId])
  @@map("organization")
}

// Pending email invitations to join an organization. The owner/admin invites by email;
// an invitation carries a single-use magic-link token that expires after 3 days. The
// invitee accepts by visiting /invite/:token while signed in with the invited email.
model OrganizationInvitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String // invited email (lower-cased)
  role        String    @default("member") // admin | member
  permissions String[]  @default([]) // per-action permissions granted on accept (members)
  token       String    @unique // magic-link token
  invitedById String // user id of the inviter
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
  @@map("organization_invitation")
}

model OrganizationMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String   @default("member") // owner | admin | member
  // Per-action permissions for "member" collaborators (owners/admins implicitly have all).
  // e.g. apiKeysTest | apiKeysLive | webhooks | products | customers | payments
  permissions String[] @default([])
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_member")
}

// ---------------- Wallet account provisioning ----------------
// A pending CosmosPay account request initiated by the (public, open-source) CosmosPay
// Wallet. Because the wallet can hold no server secret, the request is authenticated by
// a Stellar key signature (proves control of the account) and the account is only
// created after the user confirms ownership of their email via a one-time link. The
// resulting API key is delivered back to the initiating wallet via a one-time claim
// token (only its SHA-256 hash is stored here), never embedded or emailed.
model WalletRegistration {
  id             String   @id @default(cuid())
  email          String
  name           String?
  stellarAddress String
  // Single-use token in the emailed verification link.
  verifyToken    String   @unique
  // SHA-256 of the claim secret the wallet keeps; the raw secret never touches the DB.
  claimHash      String
  // pending → confirmed (account created, key awaiting claim) → claimed (key delivered).
  status         String   @default("pending")
  // "register" = email-link account creation; "link" = access-code linking to an EXISTING
  // account (the email already has a user); "social-link" = a social login for an email
  // that already has an account, held until the emailed code proves the inbox (see
  // social-onboarding.ts). Drives which flow verify/claim runs.
  kind           String   @default("register")
  // SHA-256 of the one-time access code emailed for the "link" flow (null for register).
  codeHash       String?
  // Failed access-code attempts for the "link" flow; the row locks past a small cap.
  attempts       Int      @default(0)
  // "social-link" only: the Pollar session that login earned, sealed (sealed-box.ts) while
  // the emailed code is outstanding. Cleared the moment the row is claimed, locked or
  // expired — a session is a bearer credential for a custodial wallet.
  sealedPayload  String?
  // Populated once confirmed; the API key is re-read from APISIX on claim (not stored).
  userId         String?
  organizationId String?
  credentialId   String?
  environment    String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([stellarAddress])
  @@index([claimHash])
  @@map("wallet_registration")
}

// ---------------- Wallet sign-in (own social login) — RETIRED ----------------
// The sign-in moved to the community server (its src/wallet-auth/), and so did the code that
// used these tables. They are KEPT, not dropped: `wallet_backup` holds the encrypted seeds
// people restore their wallets from, and a migration that dropped it before the export had
// been imported would destroy the only copy of some of them.
// Three tables, because the flow had three things that must outlive one request: a
// provider handshake the wallet polls, an emailed code waiting to be typed, and the
// encrypted seed a person restores on their next device.

// RETIRED — served by the community server now (src/wallet-auth/ over there). Nothing
// in this repo reads or writes this table any more; the model is kept ONLY so the rows
// survive until they are exported. Drop it in a later migration, and only after
// `npm run export:wallet-data` (scripts/export-wallet-data.mjs) has been run and its
// output imported over there.
// One "Continue with Google/GitHub" from a wallet. The wallet opens `state` in a browser,
// the provider redirects to our callback, and the wallet polls until the identity is in.
model WalletAuthHandshake {
  id            String   @id @default(cuid())
  // Random, unique, and the only thing the browser carries. Knowing it lets you POLL, not
  // redeem: redemption needs the PKCE verifier behind `codeChallenge`.
  state         String   @unique
  // "google" | "github"
  provider      String
  // base64url(SHA-256(verifier)) — RFC 7636 S256, the only method accepted.
  codeChallenge String
  // pending → authorized (identity read at the callback) → redeemed; or failed / expired.
  status        String   @default("pending")
  // What the provider proved, filled at the callback. `email` is always a VERIFIED one.
  email         String?
  name          String?
  avatar        String?
  // The provider's own user id, kept for support and audit.
  subject       String?
  // A machine-readable reason when status = failed ("email_unverified", "denied", …).
  error         String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expiresAt])
  @@map("wallet_auth_handshake")
}

// RETIRED — served by the community server now (src/wallet-auth/ over there). Nothing
// in this repo reads or writes this table any more; the model is kept ONLY so the rows
// survive until they are exported. Drop it in a later migration, and only after
// `npm run export:wallet-data` (scripts/export-wallet-data.mjs) has been run and its
// output imported over there.
// A six-digit code emailed to prove an inbox. Two ways in: an email sign-in (`via` =
// "email"), and a provider sign-in for an email that already has an account (`via` =
// "google" | "github") — the provider proves who consented, the inbox proves who opened
// the login.
model WalletLoginCode {
  id        String   @id @default(cuid())
  email     String
  name      String?
  avatar    String?
  via       String   @default("email")
  // SHA-256 of the claim token the wallet keeps. The raw token never touches the DB.
  claimHash String   @unique
  // SHA-256 of the emailed code.
  codeHash  String
  attempts  Int      @default(0)
  // pending → claimed; or locked (too many wrong codes) / expired.
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("wallet_login_code")
}

// RETIRED — served by the community server now (src/wallet-auth/ over there). Nothing
// in this repo reads or writes this table any more; the model is kept ONLY so the rows
// survive until they are exported. Drop it in a later migration, and only after
// `npm run export:wallet-data` (scripts/export-wallet-data.mjs) has been run and its
// output imported over there.
// THIS is the table the export exists for: each row may be the only copy of a funded wallet.
// The wallet's seed, encrypted ON THE DEVICE under a key derived from the person's
// password. This platform stores it and hands it back after a sign-in; it has no way to
// open it. One per account: it is the wallet a sign-in restores.
model WalletBackup {
  id             String   @id @default(cuid())
  userId         String   @unique
  // The address the box restores to — and the key that must sign any later change to it.
  stellarAddress String
  // Opaque to this server: the wallet's own sealed-box JSON (salt, KDF cost, IV, ciphertext).
  box            String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stellarAddress])
  @@map("wallet_backup")
}

// ---------------- Account recovery (SEP-30) — RETIRED ----------------
// SEP-10/SEP-30 moved to the community server (its src/recovery/), each role a separate
// deployment with its own database. A deployment was ONE of the two recovery servers,
// and `role` is on every row so that two of them sharing a database by accident still
// never shared an account. The signer this server held for an account was DERIVED from RECOVERY_SIGNER_MASTER,
// so there is no key material here — only who may ask it to sign.

// RETIRED — served by the community server now (src/recovery/ over there). Nothing
// in this repo reads or writes this table any more; the model is kept ONLY so the rows
// survive until they are exported. Drop it in a later migration, and only after
// `npm run export:wallet-data` (scripts/export-wallet-data.mjs) has been run and its
// output imported over there.
model RecoveryAccount {
  id        String   @id @default(cuid())
  // "a" | "b" — which server registered this account.
  role      String
  // The Stellar account being protected.
  address   String
  // "public" | "testnet": a signer is an entry on ONE ledger.
  network   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  methods RecoveryAuthMethod[]

  @@unique([role, address])
  @@map("recovery_account")
}

// RETIRED — served by the community server now (src/recovery/ over there). Nothing
// in this repo reads or writes this table any more; the model is kept ONLY so the rows
// survive until they are exported. Drop it in a later migration, and only after
// `npm run export:wallet-data` (scripts/export-wallet-data.mjs) has been run and its
// output imported over there.
// One way of proving you may act for an account: an email, a phone, another Stellar account.
// SEP-30 groups these under identities by role; they are stored flat so "which accounts can
// this email recover?" is an index lookup rather than a scan of JSON.
model RecoveryAuthMethod {
  id           String   @id @default(cuid())
  accountId    String
  // SEP-30 identity role: "owner" | "sender" | "receiver".
  identityRole String
  // "email" | "phone_number" | "stellar_address".
  type         String
  // Normalised at write time: an email lowercased, an address as its G… form.
  value        String
  createdAt    DateTime @default(now())

  account RecoveryAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([type, value])
  @@map("recovery_auth_method")
}
