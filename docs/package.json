{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate:sdk": "node scripts/generate-sdk.mjs",
    "generate:api": "node scripts/generate-api.mjs",
    "sync:ui": "node scripts/sync-portal-ui.mjs",
    "generate": "npm run generate:sdk && npm run generate:api && npm run apply:i18n && npm run sync:ui",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run generate",
    "build": "next build",
    "postbuild": "node scripts/set-html-lang.mjs && node scripts/write-markdown-pages.mjs",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "apply:i18n": "node scripts/apply-translations.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-openapi": "^12.5.6",
    "fumadocs-ui": "16.17.9",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zbsearch": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "^7.30.0"
  }
}
