---
// Branded error page (404 / 500 / …). Static — no React islands — so it renders reliably even
// when something is broken. Themed via the cosmos.css variables loaded by CosmosLayout.
import CosmosLayout from "@/layouts/CosmosLayout.astro";

interface Props {
  code: string | number;
  title: string;
  message: string;
  lang?: string;
}

const { code, title, message, lang } = Astro.props;
const locale = lang ?? Astro.cookies.get("cosmospay-lang")?.value ?? "en";

// Una pose por pantalla: el que piensa para el 404 (no encontramos la pagina),
// el acostado para el 500 (algo se cayo de nuestro lado).
const astro = String(code) === "500" ? "astronauta-acostado.svg" : "astronauta-pensando.svg";
---

<CosmosLayout title={`${code} — ${title} · Cosmos Pay`} noindex={true} lang={locale}>
  <main id="main" class="errp">
    <div class="errp-inner">
      <a class="errp-brand" href="/">
        <span class="cosmos-lockup" role="img" aria-label="Cosmos Pay"></span>
      </a>
      <div class="errp-code">{code}</div>
      <h1 class="errp-title">{title}</h1>
      <p class="errp-msg">{message}</p>
      <img class="errp-astro" src={`/brand/${astro}`} alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="errp-actions">
        <a class="errp-btn primary" href="/">Back to home</a>
        <a class="errp-btn" href="/dashboard">Go to dashboard</a>
      </div>
    </div>
  </main>

  <style>
    .errp {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 40px 20px;
      background: var(--bg, #ffffff);
      color: var(--ink, #000000);
      font-family: var(--ff-sans, 'Open Sauce One', system-ui, sans-serif);
    }
    .errp-inner {
      text-align: center;
      max-width: 480px;
    }
    .errp-brand {
      display: inline-flex;
      align-items: center;
      margin-bottom: 30px;
      color: var(--ink, #000000);
      text-decoration: none;
    }
    .errp-brand .cosmos-lockup {
      height: 32px;
    }
    .errp-code {
      font-weight: 300;
      font-size: clamp(72px, 18vw, 128px);
      line-height: 1;
      letter-spacing: -0.04em;
      color: var(--accent, #000877);
    }
    .errp-title {
      margin: 10px 0;
      font-size: 26px;
      font-weight: 700;
      color: var(--ink, #000000);
    }
    .errp-msg {
      margin: 0 0 24px;
      font-size: 15px;
      line-height: 1.6;
      color: var(--ink-2, rgba(0,0,0,.66));
    }
    /* el personaje va como figura con presencia (minimo 180px de alto, BRAND.md
       seccion 5) y nunca recoloreado: su blanco y negro funciona sobre los dos temas */
    .errp-astro {
      display: block;
      height: 200px;
      width: auto;
      margin: 0 auto 26px;
    }
    @media (max-width: 560px) { .errp-astro { height: 180px; } }
    .errp-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .errp-btn {
      display: inline-flex;
      align-items: center;
      padding: 11px 20px;
      border-radius: var(--radius-btn, 999px);
      border: 1px solid var(--line-2, rgba(0,0,0,.2));
      font-weight: 600;
      font-size: 14px;
      color: var(--ink, #000000);
      text-decoration: none;
      transition: background 0.15s ease, opacity 0.15s ease;
    }
    .errp-btn:hover {
      background: var(--surface-2, rgba(0,0,0,.04));
    }
    .errp-btn.primary {
      background: var(--btn-bg, #000877);
      border-color: var(--btn-bg, #000877);
      color: var(--btn-fg, #fff);
    }
    .errp-btn.primary:hover {
      background: var(--btn-bg-h, #05064F);
      border-color: var(--btn-bg-h, #05064F);
    }
  </style>
</CosmosLayout>
