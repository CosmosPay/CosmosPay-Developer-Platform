---
// Every way to hand the payment to a wallet on this device. The script shows the extension
// button only when the Cosmos Wallet extension is there and the link is a Stellar `pay`.
import { MESSAGES } from "@/lib/payments/i18n";

interface Props {
  /** Stretch the buttons to the container's width. */
  block?: boolean;
  /** Draw "Open in wallet"; off where the design has its own big button for it. */
  primary?: boolean;
}

const { block = false, primary = true } = Astro.props;
const t = MESSAGES[Astro.locals.lang ?? "en"].checkout;
---

<div class:list={["pp-actions", { "ck-actions-block": block }]}>
  {primary && <a class="btn btn-dark ck-primary" data-slot="open-wallet">{t.openWallet}</a>}
  <button class="btn btn-outline-w" type="button" data-action="pay-extension" hidden>{t.payExtension}</button>
  <a class="btn btn-outline-w" data-slot="web-wallet" target="_blank" rel="noopener" hidden>{t.webWallet}</a>
</div>
<p class="pp-hint" data-slot="ext-status" role="status" aria-live="polite"></p>
<p class="pp-hint" data-slot="tx-note" hidden>{t.txNote}</p>
