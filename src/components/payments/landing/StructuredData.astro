---
// The gateway's structured data (schema.org JSON-LD), one graph per page: the organisation (the
// same node the company site publishes, src/lib/seo/org.ts) and the site on every page, the page
// itself (with when it last changed: src/lib/seo/page-dates.ts), the breadcrumb trail a content
// page shows over its title (PageHeader.astro), and what the page is about: the gateway as a
// service on the home (where it is offered: Latin America and worldwide), the swaps on /swaps,
// the plans on /fees (the same Product node, by @id, that the company site's /pricing publishes,
// from src/lib/plans.ts) and, on /faq and the network pages, the questions and answers the page
// shows (`faq`). A guide (/learn and /learn/<slug>) passes its own trail
// (`trail`: Overview > Guides > the guide), its page types and its nodes (the article, the HowTo of
// the steps it shows, the hub's list: src/components/payments/learn/). Only what the page says: no
// ratings, reviews or claims beyond its copy. URLs come from src/lib/seo/lang-urls.ts, so they
// match the canonical and hreflang links.
import type { LandingData } from "@/components/payments/landing/data";
import type { NetworkPage, PaymentsPage, SectionPage } from "@/lib/payments/site-pages";
import { LOCALES } from "@/lib/payments/i18n";
import { PAYMENTS } from "@/lib/payments/urls";
import { SITE } from "@/components/cosmos/lib/constants";
import { explicitLang, pageUrl } from "@/lib/seo/lang-urls";
import { ORGANIZATION_NODE } from "@/lib/seo/org";
import { modifiedAt } from "@/lib/seo/page-dates-build";
import { PAYMENTS_AREA_SERVED, jsonLdText, plansProductNode, serviceNode, webPageNodes, webSiteNode, type Crumb, type JsonLdNode } from "@/lib/seo/schema";

interface Props {
  d: LandingData;
  page: PaymentsPage | "home";
  title: string;
  description: string;
  /** The questions and answers the page shows, as it shows them; the page is then an FAQPage. */
  faq?: readonly { q: string; a: string }[];
  /** The breadcrumb trail, home first and this page last, where the page draws a longer one. */
  trail?: Crumb[];
  /** schema.org types of the page node when it is more than a WebPage (FAQPage is added for `faq`). */
  pageTypes?: string[];
  /** What the page mainly shows, by @id, when it is not its questions. */
  mainEntity?: string;
  /** The page's own nodes (an article, a HowTo, a list). */
  nodes?: JsonLdNode[];
}

const { d, page, title, description, faq, trail, pageTypes, mainEntity, nodes = [] } = Astro.props;
const { t, lang } = d;
const codes = LOCALES.map((l) => l.code);
const explicit = explicitLang(Astro.url.searchParams.get("lang"), codes);
const path = Astro.locals.publicPath ?? "/";
const url = pageUrl(PAYMENTS, path, explicit);
const KEY = {
  integrations: "integrations",
  swaps: "swaps",
  "use-cases": "useCases",
  security: "security",
  fees: "fees",
  compare: "compare",
  faq: "faq",
  stellar: "stellar",
  solana: "solana",
  monad: "monad",
} as const satisfies Record<SectionPage | NetworkPage, keyof typeof t.pages>;
const questions = faq ?? (page === "faq" ? d.faq : undefined);
const types = [...(pageTypes ?? ["WebPage"]), ...(questions ? ["FAQPage"] : [])];

// What the page is about, by page. Entity @ids do not carry ?lang=: one service, one set of plans.
const about: JsonLdNode | null =
  page === "home"
    ? serviceNode({ id: `${PAYMENTS}/#service`, name: "Cosmos Pay Payments", serviceType: "Payment gateway", description, url: `${PAYMENTS}/`, site: SITE, areaServed: PAYMENTS_AREA_SERVED })
    : page === "swaps"
      ? serviceNode({ id: `${PAYMENTS}/swaps#service`, name: "Cosmos Pay Swaps", serviceType: "Token swaps", description, url: `${PAYMENTS}/swaps`, site: SITE })
      : page === "fees"
        ? plansProductNode(SITE)
        : null;

const graph: JsonLdNode[] = [
  ORGANIZATION_NODE,
  webSiteNode({
    origin: PAYMENTS,
    name: "Cosmos Pay Payments",
    site: SITE,
    langs: codes,
    description: "Payment links, a hosted checkout and a payments API to accept stablecoins on Stellar, Solana and Monad.",
  }),
  ...webPageNodes({
    url,
    name: title,
    description,
    lang,
    origin: PAYMENTS,
    types,
    dateModified: modifiedAt("payments", path, lang),
    breadcrumb:
      trail ??
      (page === "home" || !(page in KEY)
        ? undefined
        : [
            { name: t.pages.home, url: pageUrl(PAYMENTS, "/", explicit) },
            { name: (t.pages[KEY[page as keyof typeof KEY]] as { nav: string }).nav, url },
          ]),
    mainEntity: questions
      ? questions.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } }))
      : (mainEntity ?? (about?.["@id"] as string | undefined)),
  }),
  ...(about ? [about] : []),
  ...nodes,
];
---

<script type="application/ld+json" set:html={jsonLdText(graph)} />
