---
// The gateway's structured data (schema.org JSON-LD), one graph per page: the organisation (the
// same node the company site publishes, src/lib/seo/org.ts) and the site on every page, the page
// itself, the breadcrumb trail a content page shows over its title (PageHeader.astro), and what
// the page is about: the gateway as a service on the home, the swaps on /swaps, the plans with a
// fixed price on /fees (from src/lib/plans.ts) and, on /faq and the network pages, the questions
// and answers the page shows (`faq`). Only what the page says: no ratings, reviews or claims
// beyond its copy. URLs come from src/lib/seo/lang-urls.ts, so they match the canonical and
// hreflang links.
import type { LandingData } from "@/components/payments/landing/data";
import type { PaymentsPage } from "@/lib/payments/site-pages";
import { LOCALES } from "@/lib/payments/i18n";
import { PAYMENTS } from "@/lib/payments/urls";
import { SITE } from "@/components/cosmos/lib/constants";
import { explicitLang, pageUrl } from "@/lib/seo/lang-urls";
import { ORGANIZATION_NODE } from "@/lib/seo/org";
import { jsonLdText, plansProductNode, serviceNode, webPageNodes, webSiteNode, type JsonLdNode } from "@/lib/seo/schema";

interface Props {
  d: LandingData;
  page: PaymentsPage | "home";
  title: string;
  description: string;
  /** The questions and answers the page shows, as it shows them; the page is then an FAQPage. */
  faq?: readonly { q: string; a: string }[];
}

const { d, page, title, description, faq } = Astro.props;
const { t, lang } = d;
const codes = LOCALES.map((l) => l.code);
const explicit = explicitLang(Astro.url.searchParams.get("lang"), codes);
const url = pageUrl(PAYMENTS, Astro.locals.publicPath ?? "/", explicit);
const KEY = {
  integrations: "integrations",
  swaps: "swaps",
  "use-cases": "useCases",
  security: "security",
  fees: "fees",
  compare: "compare",
  faq: "faq",
  stellar: "stellar",
  solana: "solana",
  monad: "monad",
} as const satisfies Record<PaymentsPage, keyof typeof t.pages>;
const questions = faq ?? (page === "faq" ? d.faq : undefined);

// What the page is about, by page. Entity @ids do not carry ?lang=: one service, one set of plans.
const about: JsonLdNode | null =
  page === "home"
    ? serviceNode({ id: `${PAYMENTS}/#service`, name: "Cosmos Pay Payments", serviceType: "Payment gateway", description, url: `${PAYMENTS}/`, site: SITE })
    : page === "swaps"
      ? serviceNode({ id: `${PAYMENTS}/swaps#service`, name: "Cosmos Pay Swaps", serviceType: "Token swaps", description, url: `${PAYMENTS}/swaps`, site: SITE })
      : page === "fees"
        ? plansProductNode({ url: `${PAYMENTS}/fees`, site: SITE, description, image: `${PAYMENTS}/media/coin-ramp-poster.jpg` })
        : null;

const graph: JsonLdNode[] = [
  ORGANIZATION_NODE,
  webSiteNode({
    origin: PAYMENTS,
    name: "Cosmos Pay Payments",
    site: SITE,
    langs: codes,
    description: "Payment links, a hosted checkout and a payments API to accept stablecoins on Stellar, Solana and Monad.",
  }),
  ...webPageNodes({
    url,
    name: title,
    description,
    lang,
    origin: PAYMENTS,
    types: questions ? ["WebPage", "FAQPage"] : undefined,
    breadcrumb:
      page === "home"
        ? undefined
        : [
            { name: t.pages.home, url: pageUrl(PAYMENTS, "/", explicit) },
            { name: (t.pages[KEY[page]] as { nav: string }).nav, url },
          ],
    mainEntity: questions
      ? questions.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } }))
      : (about?.["@id"] as string | undefined),
  }),
  ...(about ? [about] : []),
];
---

<script type="application/ld+json" set:html={jsonLdText(graph)} />
