---
// The landing's line icons (24px grid, 1.8 stroke, currentColor). Decorative: the text
// next to each one says the same thing.
interface Props {
  name:
    | "link" | "checkout" | "api" | "webhook" | "dashboard" | "flask"
    | "chain" | "key" | "frame" | "layers" | "clock" | "book"
    | "store" | "globe" | "download" | "heart" | "check";
}

const { name } = Astro.props;
---

<svg class="pl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "link" && <Fragment><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" /></Fragment>}
  {name === "checkout" && <Fragment><rect x="3.5" y="4" width="17" height="16" rx="2.5" /><path d="M3.5 9h17M8 14h3M8 16.5h5" /><rect x="14.5" y="13" width="3" height="3" rx=".6" /></Fragment>}
  {name === "api" && <Fragment><path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5.5l-3 13" /></Fragment>}
  {name === "webhook" && <Fragment><path d="M9.5 8.5a3 3 0 1 1 5 2.2L12 15" /><path d="M7 19a3 3 0 1 1 2-5.2h6" /><path d="M17 19a3 3 0 1 0-1.6-5.5L13 9.5" /></Fragment>}
  {name === "dashboard" && <Fragment><rect x="3.5" y="3.5" width="7" height="9" rx="1.5" /><rect x="13.5" y="3.5" width="7" height="5" rx="1.5" /><rect x="13.5" y="11.5" width="7" height="9" rx="1.5" /><rect x="3.5" y="15.5" width="7" height="5" rx="1.5" /></Fragment>}
  {name === "flask" && <Fragment><path d="M9.5 3.5h5M10.5 3.5v5.2L5 18.2A1.6 1.6 0 0 0 6.4 20.5h11.2a1.6 1.6 0 0 0 1.4-2.3l-5.5-9.5V3.5" /><path d="M7.5 14.5h9" /></Fragment>}
  {name === "chain" && <Fragment><rect x="3.5" y="9" width="6" height="6" rx="1.5" /><rect x="14.5" y="9" width="6" height="6" rx="1.5" /><path d="M9.5 12h5M6.5 9V6.5h11V9M6.5 15v2.5h11V15" /></Fragment>}
  {name === "key" && <Fragment><circle cx="8" cy="15" r="4" /><path d="m11 12 8.5-8.5M16 7l2.5 2.5M14 9l2 2" /></Fragment>}
  {name === "frame" && <Fragment><rect x="3.5" y="4.5" width="17" height="15" rx="2.5" /><path d="m9 10 6 6M15 10l-6 6" /></Fragment>}
  {name === "layers" && <Fragment><path d="m12 3.5 8.5 4.5-8.5 4.5L3.5 8z" /><path d="m3.5 12.5 8.5 4.5 8.5-4.5M3.5 16.5 12 21l8.5-4.5" /></Fragment>}
  {name === "clock" && <Fragment><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></Fragment>}
  {name === "book" && <Fragment><path d="M4.5 5.5A2 2 0 0 1 6.5 3.5h13v14h-13a2 2 0 0 0-2 2z" /><path d="M4.5 19.5a2 2 0 0 0 2 2h13v-4" /></Fragment>}
  {name === "store" && <Fragment><path d="M4 9.5 5.5 4h13L20 9.5M4 9.5h16M4 9.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0" /><path d="M5.5 12v8.5h13V12M10 20.5V15h4v5.5" /></Fragment>}
  {name === "globe" && <Fragment><circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17M12 3.5c2.5 2.6 3.5 5.4 3.5 8.5s-1 5.9-3.5 8.5c-2.5-2.6-3.5-5.4-3.5-8.5S9.5 6.1 12 3.5z" /></Fragment>}
  {name === "download" && <Fragment><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M4.5 17.5v2a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1v-2" /></Fragment>}
  {name === "heart" && <Fragment><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z" /></Fragment>}
  {name === "check" && <Fragment><path d="m5 12.5 4.5 4.5L19 7.5" /></Fragment>}
</svg>
