---
// The gateway's section navigation (multi-page layout): its pages in one sticky row under the
// general nav, the current one marked, and the main call to action at its end so it is one
// click away on every screen. The general nav stays above it, as on every page.
import type { LandingData } from "@/components/payments/landing/data";
import { PAYMENTS_PAGES, pagePath, type PaymentsPage } from "@/lib/payments/site-pages";

interface Props {
  d: LandingData;
  current: PaymentsPage | "home";
}

const { d, current } = Astro.props;
const { t, CREATE_LINK } = d;
const KEY: Record<PaymentsPage, keyof typeof t.pages> = {
  integrations: "integrations",
  "use-cases": "useCases",
  security: "security",
  fees: "fees",
  faq: "faq",
};
const items = [
  { href: "/", label: t.pages.home, here: current === "home" },
  ...PAYMENTS_PAGES.map((page) => ({ href: pagePath(page), label: (t.pages[KEY[page]] as { nav: string }).nav, here: current === page })),
];
---

<nav class="pl-subnav" aria-label={t.pages.nav}>
  <div class="wrap pl-subnav-inner">
    <ul class="pl-subnav-links" role="list">
      {items.map((it) => (
        <li><a href={it.href} aria-current={it.here ? "page" : undefined}>{it.label}</a></li>
      ))}
    </ul>
    <a class="btn btn-dark btn-sm pl-subnav-cta" href={CREATE_LINK}>{t.hero.primary}</a>
  </div>
</nav>
