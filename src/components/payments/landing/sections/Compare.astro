---
// Compare section of the payments landing (see src/pages/payments/index.astro for the page
// it belongs to). Its data comes from landingData (../data.ts).
import Icon from "@/components/payments/landing/Icon.astro";
import Mark from "@/components/payments/landing/Mark.astro";
import Mock from "@/components/payments/landing/Mock.astro";
import Code from "@/components/payments/landing/Code.astro";
import type { LandingData } from "@/components/payments/landing/data";

interface Props {
  d: LandingData;
}

const { layout, links, DOCS, PRICING, t, CREATE_LINK, CONTACT, lowestRate, marked, heroMark, ctaMark, brand, marquees, USE_PHOTO_FOCUS, benefits, settleModes, compareRows, paths, stepMocks, steps, PAY_ORIGIN, EMBED_TAG, useCases, security, plans, calcPlans, ESCROW_PCT, faq, SDK_CODE, WEBHOOK_CODE, CODE, codeTabs, integrations, PLUGINS, lang } = Astro.props.d;
---

<section class="pl-section pl-section-alt" aria-labelledby="pl-compare">
  <div class="wrap">
    <div class="pl-head pl-head-art" data-reveal>
      <h2 id="pl-compare">{t.compare.title} {t.compare.titleBold}</h2>
      <img class="pl-art pl-compare-art" src="/brand/astronauta-acostado.svg" alt="" width="260" height="141" loading="lazy" decoding="async" />
    </div>
    <div class="pl-compare-card">
      <table class="pl-compare">
        <caption class="pl-sr">{t.compare.caption}</caption>
        <thead>
          <tr>
            <th scope="col"><span class="pl-sr">{t.compare.topic}</span></th>
            <th scope="col">{t.compare.cards}</th>
            <th scope="col" class="pl-compare-us">{t.compare.us}</th>
          </tr>
        </thead>
        <tbody>
          {compareRows.map((row, i) => (
            <tr data-reveal style={`--i: ${i}`}>
              <th scope="row">{row.k}</th>
              <td data-label={t.compare.cards}>{row.cards}</td>
              <td class="pl-compare-us" data-label={t.compare.us}>
                <div class="pl-compare-val"><span class="pl-check"><Icon name="check" /></span><span>{row.us}</span></div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="pl-footnote" data-reveal>{t.compare.note}</p>
  </div>
</section>
