---
// Uses section of the payments landing (see src/pages/payments/index.astro for the page
// it belongs to). Its data comes from landingData (../data.ts).
import Icon from "@/components/payments/landing/Icon.astro";
import Mark from "@/components/payments/landing/Mark.astro";
import Mock from "@/components/payments/landing/Mock.astro";
import Code from "@/components/payments/landing/Code.astro";
import type { LandingData } from "@/components/payments/landing/data";

interface Props {
  d: LandingData;
}

const { layout, links, DOCS, PRICING, t, CREATE_LINK, CONTACT, lowestRate, marked, heroMark, ctaMark, brand, marquees, USE_PHOTO_FOCUS, benefits, settleModes, compareRows, paths, stepMocks, steps, PAY_ORIGIN, EMBED_TAG, useCases, security, plans, calcPlans, ESCROW_PCT, faq, SDK_CODE, WEBHOOK_CODE, CODE, codeTabs, integrations, PLUGINS, lang } = Astro.props.d;
---

<!-- Use cases by business, as tabs (the script below wires the keyboard). Pinned like
     "how it works": scrolling walks through the four businesses, a tab jumps to its own. -->
<section class="pl-section pl-section-alt pl-uses-section" aria-labelledby="pl-uses" data-pin style="--n: 4">
  <div class="pl-pin">
  <div class="pl-pin-stage">
  <div class="wrap">
    <div class="pl-head pl-pin-head" data-reveal>
      <h2 id="pl-uses">{t.useCases.title} {t.useCases.titleBold}</h2>
          <div class="pl-pin-meter" aria-hidden="true">
            <span class="pl-pin-count" data-pin-count data-template={t.useCases.counter}>{t.useCases.counter.replace("{n}", "1").replace("{total}", "4")}</span>
            <span class="pl-pin-bar">{[0, 1, 2, 3].map(() => <i></i>)}</span>
          </div>
    </div>
    <div class="pl-uses" data-tabs data-reveal data-pin-tabs>
      <div class="pl-uses-tabs" role="tablist" aria-label={t.useCases.label} aria-orientation="vertical">
        {useCases.map((u, i) => (
          <button
            type="button"
            class="pl-uses-tab"
            role="tab"
            id={`pl-use-tab-${u.key}`}
            aria-controls={`pl-use-${u.key}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            {u.title}
          </button>
        ))}
      </div>
      {useCases.map((u, i) => (
        <div class="pl-uses-panel" role="tabpanel" id={`pl-use-${u.key}`} aria-labelledby={`pl-use-tab-${u.key}`} tabindex="0" hidden={i !== 0}>
          <div class="pl-uses-text">
            <h3>{u.title}</h3>
            <p class="pl-uses-body">{u.body}</p>
            <ul class="pl-checks" role="list">
              {u.points.map((point) => (
                <li><span class="pl-check"><Icon name="check" /></span>{point}</li>
              ))}
            </ul>
            <p class="pl-uses-built">{t.useCases.built} {u.uses}</p>
          </div>
          <div class="pl-uses-visual">
            <img class="pl-uses-photo" src={`/media/landing/use-${u.key}.webp`} alt="" width="960" height="641" loading="lazy" decoding="async" style={`object-position: ${USE_PHOTO_FOCUS[u.key]}`} />
            <Mock name={`use-${u.key}`} ui={t.ui} />
          </div>
        </div>
      ))}
    </div>
  </div>
  </div>
  </div>
</section>
