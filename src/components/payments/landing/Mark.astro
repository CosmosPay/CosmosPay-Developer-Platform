---
// Brand marks drawn in currentColor, so they follow the theme. Only single-colour official
// artwork lives here: Stellar's mark (from Stellar's brand kit, as the Cosmos wallet ships it)
// and the Cosmos isotype (public/brand/isotipo-mono.svg). Full-colour logos are files in
// public/media/brands. Decorative: the name is always written next to the mark.
type MarkName = "stellar" | "cosmos";
interface Props {
  name: MarkName;
}

const { name } = Astro.props;
