---
/* FiatCharge.astro: the shell of /fiat/{id}, a charge in local money.
 *
 * Every string is rendered here from the payments catalog; the script
 * (src/scripts/payments/fiat-request.ts) reads the charge, fills the data-slot elements with
 * textContent and switches the views (`data-when` lists the views an element shows in):
 *   - choose: the charge takes a bank transfer and other methods, so the payer picks one first
 *     (bank transfer first, recommended); a charge with one way goes straight to it;
 *   - bank transfer: document (CUIT/CUIL or DNI), sending (the button busy), transfer (the deposit
 *     instructions, followed until the money arrives), transfer-expired (the instructions ran out);
 *   - other methods: open (pick a method, pay), opening (the button busy), waiting (the secure
 *     window is open);
 *   - processing (the transfer arrived, the token is on its way), paid, expired, cancelled.
 * The loading, not-found and error states are cards of their own, as on the checkout. Mobile
 * first: a buyer scans the seller's QR with a phone.
 */
import "@/styles/checkout.css";
import "@/styles/fiat.css";
import { MESSAGES } from "@/lib/payments/i18n";
import { API_BASE } from "@/lib/payments/urls";

interface Props {
  /** The charge to read. */
  id: string;
}

const { id } = Astro.props;
const lang = Astro.locals.lang ?? "en";
const m = MESSAGES[lang];
const t = m.fiat;
// Only the strings the script swaps in at runtime; the rest is rendered here.
const runtime = {
  phase: t.phase,
  body: t.body,
  receives: t.receives,
  networkFallback: t.networkFallback,
  methodRequired: t.methodRequired,
  noMethods: t.noMethods,
  pay: t.pay,
  opening: t.opening,
  methodUnavailable: t.methodUnavailable,
  openFailed: t.openFailed,
  closed: t.closed,
  errorBody: t.errorBody,
  rateLimited: t.rateLimited,
  documentEmpty: t.documentEmpty,
  documentShape: t.documentShape,
  documentCheck: t.documentCheck,
  getDetails: t.getDetails,
  gettingDetails: t.gettingDetails,
  invalidDocument: t.invalidDocument,
  transferGone: t.transferGone,
  transferGoneOther: t.transferGoneOther,
  transferDown: t.transferDown,
  transferDownOther: t.transferDownOther,
  transferFailed: t.transferFailed,
  copy: t.copy,
  copied: t.copied,
  copiedLabel: t.copiedLabel,
  expiresIn: t.expiresIn,
  endingIn: t.endingIn,
};
// `<` escaped so no string can close the JSON <script> block early.
const runtimeJson = JSON.stringify(runtime).replace(/</g, "\\u003c");
// The values a payer copies into their bank, each with its own button.
const copyRows = [
  { name: "alias", label: t.aliasLabel },
  { name: "cvu", label: t.cvuLabel },
] as const;
---

<main id="main" class="ck-page">
  <section class="ck fq" id="fiat" data-id={id} data-api={API_BASE} data-lang={lang} aria-label={t.eyebrow}>
    <div class="ck-card ck-solo" data-state="loading" role="status">
      <div class="pp-loading"><span class="pp-spinner" aria-hidden="true"></span>{t.loading}</div>
    </div>

    <div class="ck-card ck-solo" data-state="not-found" hidden>
      <h1 class="pp-title">{t.notFoundTitle}</h1>
      <p class="pp-body">{t.notFoundBody}</p>
    </div>

    <div class="ck-card ck-solo" data-state="error" hidden>
      <h1 class="pp-title">{t.errorTitle}</h1>
      <p class="pp-body" data-slot="error-body" role="status" aria-live="polite">{t.errorBody}</p>
      <button class="btn btn-dark btn-sm" type="button" data-action="retry">{t.retry}</button>
    </div>

    <div class="ck-card fq-card" data-state="request" hidden>
      <div class="ck-brand">
        <span class="cosmos-mark ck-mark" aria-hidden="true"></span>
        <span class="ck-eyebrow">{t.eyebrow}</span>
        <span class="pp-testnet" data-slot="testnet" hidden>{m.checkout.testnetTier}</span>
      </div>

      <div class="fq-head">
        <h1 class="fq-amount" data-slot="amount"></h1>
        <p class="fq-currency" data-slot="currency"></p>
        <p class="fq-desc" data-slot="description" hidden></p>
      </div>

      <div class="pp-status fq-status" role="status" aria-live="polite">
        <span class="pp-pill" data-slot="phase"></span>
        <p class="pp-body" data-slot="phase-body"></p>
      </div>

      <p class="fq-receives" data-slot="receives" hidden></p>

      {/* Two ways to pay: a choice, bank transfer first (no sign-up, the recommended one). */}
      <div class="fq-choice" role="group" aria-label={t.choiceLabel} data-when="choose" hidden>
        <button class="fq-option" type="button" data-action="choose-transfer">
          <span class="fq-option-icon fq-icon-bank" aria-hidden="true"></span>
          <span class="fq-option-text">
            <span class="fq-option-title">{t.transferTitle}</span>
            <span class="fq-option-desc">{t.transferDesc}</span>
          </span>
          <span class="fq-recommended">{t.recommended}</span>
        </button>
        <button class="fq-option" type="button" data-action="choose-p2p">
          <span class="fq-option-icon fq-icon-other" aria-hidden="true"></span>
          <span class="fq-option-text">
            <span class="fq-option-title">{t.otherTitle}</span>
            <span class="fq-option-desc">{t.otherDesc}</span>
          </span>
        </button>
      </div>

      {/* Bank transfer, first step: who pays (their CUIT/CUIL or DNI), never kept by the page. */}
      <form class="fq-doc" data-when="document sending" novalidate hidden>
        <label class="fq-label" for="fq-document">{t.documentLabel}</label>
        <p class="fq-hint" id="fq-document-hint">{t.documentHint}</p>
        <input
          id="fq-document"
          class="fq-input"
          name="document"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          maxlength="20"
          aria-describedby="fq-document-hint fq-document-error"
        />
        <p class="fq-error" id="fq-document-error" data-slot="document-error" role="alert" hidden></p>
        <button class="btn btn-dark fq-cta" type="submit" data-slot="document-button">
          <span class="pp-spinner fq-busy" data-slot="document-busy" aria-hidden="true" hidden></span>
          <span data-slot="document-label">{t.getDetails}</span>
        </button>
        <button class="fq-link fq-back" type="button" data-action="back">{t.back}</button>
      </form>

      {/* Bank transfer, second step: where to send the exact amount, each value with its copy button. */}
      <section class="fq-transfer" data-when="transfer transfer-expired" aria-labelledby="fq-transfer-title" hidden>
        <h2 class="fq-transfer-title" id="fq-transfer-title" tabindex="-1">{t.instructionsTitle}</h2>
        <div class="fq-well">
          <div class="fq-copyrow fq-copyrow-amount">
            <div class="fq-copytext">
              <span class="fq-k">{t.amountLabel}</span>
              <span class="fq-v fq-v-amount" data-slot="t-amount"></span>
              <span class="fq-note">{t.exactNote}</span>
              <span class="fq-note fq-cents" data-slot="t-cents" hidden>{t.centsNote}</span>
            </div>
            <button class="pp-copy fq-copy" type="button" data-copy="amount" data-label={t.amountLabel} aria-label={`${t.copy}: ${t.amountLabel}`}>{t.copy}</button>
          </div>
          {copyRows.map((row) => (
            <div class="fq-copyrow">
              <div class="fq-copytext">
                <span class="fq-k">{row.label}</span>
                <span class={`fq-v fq-v-${row.name}`} data-slot={`t-${row.name}`}></span>
              </div>
              <button class="pp-copy fq-copy" type="button" data-copy={row.name} data-label={row.label} aria-label={`${t.copy}: ${row.label}`}>{t.copy}</button>
            </div>
          ))}
          <div class="fq-copyrow fq-plainrow" data-row="t-holder" hidden>
            <div class="fq-copytext">
              <span class="fq-k">{t.holderLabel}</span>
              <span class="fq-v" data-slot="t-holder"></span>
            </div>
          </div>
          <div class="fq-copyrow fq-plainrow" data-row="t-bank" hidden>
            <div class="fq-copytext">
              <span class="fq-k">{t.bankLabel}</span>
              <span class="fq-v" data-slot="t-bank"></span>
            </div>
          </div>
        </div>
        <p class="fq-expiry" data-slot="t-expiry" hidden></p>
        <ol class="fq-steps" aria-label={t.transferStepsLabel}>
          <li>{t.tstep1}</li>
          <li>{t.tstep2}</li>
          <li>{t.tstep3}</li>
        </ol>
        <div class="fq-waiting-actions">
          <button class="btn btn-dark fq-cta" type="button" data-action="new-transfer" data-slot="new-transfer" hidden>{t.newDetails}</button>
          <button class="fq-link fq-back" type="button" data-action="back">{t.back}</button>
        </div>
      </section>
      <p class="sr-only" data-slot="copy-status" role="status" aria-live="polite"></p>

      <form class="fq-pay" data-when="open opening" novalidate>
        <fieldset class="fq-methods" aria-describedby="fq-method-error">
          <legend class="fq-legend">{t.methodLabel}</legend>
          <div class="fq-method-list" data-slot="methods"></div>
        </fieldset>
        <p class="fq-error" id="fq-method-error" data-slot="pay-error" role="alert" hidden></p>
        <button class="btn btn-dark fq-cta" type="submit" data-slot="pay-button">
          <span class="pp-spinner fq-busy" data-slot="pay-busy" aria-hidden="true" hidden></span>
          <span data-slot="pay-label"></span>
        </button>
        <button class="fq-link fq-back" type="button" data-action="back">{t.back}</button>
      </form>

      <div class="fq-waiting" data-when="waiting" hidden>
        <p class="fq-blocked" data-slot="blocked" hidden>{t.blocked}</p>
        <a class="btn btn-dark fq-cta" data-slot="widget-open" target="_blank" rel="noopener noreferrer" hidden>{t.openWindow}</a>
        <div class="fq-waiting-actions">
          <a class="fq-link" data-slot="widget-reopen" target="_blank" rel="noopener noreferrer">{t.reopen}</a>
          <button class="fq-link" type="button" data-action="change">{t.changeMethod}</button>
        </div>
      </div>

      {/* How paying goes, in order and by who does it: before the click and while the window is open
          (the identity check happens there, the first time). */}
      <ol class="fq-steps" data-when="open opening waiting" aria-label={t.stepsLabel}>
        <li>{t.step1}</li>
        <li>{t.step2}</li>
        <li>{t.step3}</li>
      </ol>

      <dl class="pp-details ck-facts fq-facts">
        <div class="pp-row" data-row="method" hidden><dt>{t.methodLabel}</dt><dd data-slot="method-name"></dd></div>
        <div class="pp-row" data-row="document" hidden><dt>{t.documentRow}</dt><dd data-slot="document-hint"></dd></div>
        <div class="pp-row" data-row="expires" hidden><dt>{t.expires}</dt><dd><time data-slot="expires"></time></dd></div>
        <div class="pp-row" data-row="paid" hidden><dt>{t.paidAt}</dt><dd><time data-slot="paid-at"></time></dd></div>
      </dl>
    </div>
  </section>
</main>

<script type="application/json" id="fiat-i18n" set:html={runtimeJson} />

<script>
  import { startFiatRequest } from "@/scripts/payments/fiat-request";

  startFiatRequest();
</script>
