---
// The company site's structured data (schema.org JSON-LD), one graph per page: the organisation
// (src/lib/seo/org.ts, the same node the gateway's pages publish), the site, the page with its
// breadcrumb trail, and what the page adds (the products on the home, the plans on /pricing; /about
// is an AboutPage whose mainEntity is the organisation itself).
// CosmosLayout renders it with the page's own address in the language shown (the bare path in
// English, ?lang= otherwise: src/lib/seo/lang-urls.ts), the address its canonical and hreflang
// links name (/swaps, canonical on the gateway, still describes its own address), and when the
// page last changed (dateModified, src/lib/seo/page-dates.ts). Only what the pages and
// src/lib/plans.ts state: no ratings, reviews or claims beyond them.
import { SITE } from "@/components/cosmos/lib/constants";
import { ORGANIZATION_ID, ORGANIZATION_NODE } from "@/lib/seo/org";
import { SITE_LANGS } from "@/lib/seo/site-meta";
import { jsonLdText, webPageNodes, webSiteNode, type Crumb, type JsonLdNode } from "@/lib/seo/schema";

interface Props {
  /** The canonical URL of the version shown. */
  url: string;
  title: string;
  description: string;
  lang: string;
  /** The share image (absolute). */
  image: string;
  breadcrumb?: Crumb[];
  mainEntity?: string;
  /** The page's schema.org type when it is more specific than WebPage ("AboutPage"). */
  pageType?: string;
  schema?: JsonLdNode[];
  /** When the page last changed (src/lib/seo/page-dates.ts). */
  dateModified?: string | null;
}

const { url, title, description, lang, image, breadcrumb, mainEntity, pageType, schema = [], dateModified } = Astro.props;
const home = new URL(url).pathname === "/";

const graph: JsonLdNode[] = [
  ORGANIZATION_NODE,
  webSiteNode({ origin: SITE, name: "Cosmos Pay", site: SITE, langs: SITE_LANGS }),
  ...webPageNodes({
    url,
    name: title,
    description,
    lang,
    origin: SITE,
    types: pageType ? [pageType] : undefined,
    breadcrumb,
    mainEntity,
    ...(home && { about: ORGANIZATION_ID }),
    image: { url: image, width: 1200, height: 630 },
    dateModified,
  }),
  ...schema,
];
---

<script type="application/ld+json" set:html={jsonLdText(graph)} />
