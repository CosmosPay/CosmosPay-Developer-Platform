---
import "@/styles/dashboard.css";
import CosmosLayout from "@/layouts/CosmosLayout.astro";
import Dashboard from "@/components/cosmos/Dashboard.tsx";
import { getProfile, getRole } from "@/lib/profile";
import { listForUser, ensureDefaultOrg } from "@/lib/organizations";
import { planFeatures, ONBOARDING_ENABLED } from "@/lib/features";
import { DEFAULT_PLAN_ID } from "@/lib/plans";

// Auth guard: the dashboard is only for logged-in developers.
// Astro.locals.user is populated by src/middleware.ts from the Authentik session.
// Signed-out visitors go to /login, which starts the OAuth flow and lands back here.
const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/login");
}

// What the first render needs, read together rather than one after another: the organizations
// (the onboarding gate and the shell's list), the profile and the account role.
// A failed read is not "no organizations": it leaves `orgs` null, the gate is skipped and the
// shell reads them itself, rather than sending someone with organizations to create a first one.
let [orgs, profile, role] = await Promise.all([
  listForUser(user.id).catch(() => null),
  getProfile(user.id).catch(() => null),
  getRole(user.id).catch(() => "user"),
]);

// Onboarding gate: a user with no organization must create their first one first.
if (orgs && orgs.length === 0) {
  // With onboarding enabled, send them through the wizard. With it disabled, skip
  // straight to a default organization so they land on the dashboard.
  if (ONBOARDING_ENABLED) {
    return Astro.redirect("/onboarding");
  }
  orgs = await ensureDefaultOrg(user.id, user.name).catch(() => []);
  if (orgs.length === 0) {
    return Astro.redirect("/onboarding");
  }
}

const lang = Astro.cookies.get("cosmospay-lang")?.value ?? "en";
// The environment last picked (Dashboard writes the cookie), so a reload opens on it.
const env = Astro.cookies.get("cosmospay-env")?.value === "prod" ? "prod" : "dev";
// The organization last picked (Dashboard writes the cookie), if it is still one of theirs, and
// the view the address names: the first render is already the right view of the right
// organization, so no view mounts only to be replaced and nothing waits for the organizations.
const wantOrg = Astro.cookies.get("cosmospay-org")?.value;
const orgId = orgs && orgs.some((o) => o.id === wantOrg) ? wantOrg : null;
const view = Astro.url.searchParams.get("view");
// Account role (user | support | admin | owner); gates staff features (support inbox,
// user management). The first account bootstraps to "owner" (see getRole). Best-effort.
const plan = profile?.plan ?? DEFAULT_PLAN_ID;
// The custom profile (displayName / avatarUrl) overrides the OAuth name + photo when set.
// We pass both the effective values (name/image) and the raw OAuth fallbacks (authName/
// authImage) so the account editor can revert cleanly when a custom value is cleared.
const dashUser = {
  id: user.id,
  name: profile?.displayName || user.name,
  email: user.email,
  image: profile?.avatarUrl || user.image,
  role,
  plan,
  authName: user.name,
  authImage: user.image ?? null,
  displayName: profile?.displayName ?? "",
  bio: profile?.bio ?? "",
};
// Plan/onboarding flags resolved for this account (drives plan UI gating).
const features = planFeatures(role);
// As /api/organizations answers them (dates as ISO strings), so the shell reads one shape; null
// when they could not be read here (the shell then loads them).
const initialOrgs = orgs ? orgs.map((o) => ({ ...o, createdAt: new Date(o.createdAt).toISOString() })) : null;
---

<CosmosLayout title="Dashboard | Cosmos Pay" lang={lang} noindex nav={false} bodyClass="inst">
  <Dashboard client:load user={dashUser} lang={lang} features={features} env={env} orgs={initialOrgs} orgId={orgId} view={view} />
</CosmosLayout>
