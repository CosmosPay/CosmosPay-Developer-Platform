---
import CosmosLayout from "@/layouts/CosmosLayout.astro";
import Landing from "@/components/cosmos/Landing.tsx";
import { siteMeta } from "@/lib/seo/site-meta";
import { companyProductNodes } from "@/lib/seo/org";

// The language the middleware resolved: ?lang= (each language has its own address), then the
// cookie, then Accept-Language.
const lang = Astro.locals.lang ?? "en";
const meta = siteMeta("home", lang);
const user = Astro.locals.user
  ? { name: Astro.locals.user.name, email: Astro.locals.user.email, image: Astro.locals.user.image }
  : null;
---

<CosmosLayout
  nav={false}
  title={meta.title}
  description={meta.description}
  lang={lang}
  preloadImage={{ light: "/brand/personaje/celular-negro.png", dark: "/brand/personaje/celular-sticker.png" }}
  schema={companyProductNodes()}
>
  <Landing client:load user={user} lang={lang} />
</CosmosLayout>
