---
import CosmosLayout from "@/layouts/CosmosLayout.astro";
import Landing from "@/components/cosmos/Landing.tsx";
import { messages } from "@/lib/i18n/messages/index";

const lang = Astro.cookies.get("cosmospay-lang")?.value ?? "en";
const user = Astro.locals.user
  ? { name: Astro.locals.user.name, email: Astro.locals.user.email, image: Astro.locals.user.image }
  : null;
// The title and description say what the company site is (a stablecoin payments API, checkout and
// wallet on Stellar, Solana and Monad, for Latin America), in the visitor's language.
const meta = (messages[lang as keyof typeof messages] ?? messages.en).landing.meta;
---

<CosmosLayout
  nav={false}
  title={meta.title}
  description={meta.description}
  lang={lang}
  preloadCinta
>
  <Landing client:load user={user} lang={lang} />
</CosmosLayout>
