---
/* /tos holds the General Terms & Conditions covering both Cosmos Pay products (the gateway and the
 * wallet); the text is src/lib/site/terms.ts, which the page's Markdown version reads too.
 *
 * Public page in English and Spanish (PAGE_LANGS.tos): ?lang=es or a Spanish visitor gets the
 * Spanish text, any other language the English one (its canonical is then the English version).
 * The wallet links here from its onboarding consent checkbox (TERMS_URL).
 */
import CosmosLayout from "@/layouts/CosmosLayout.astro";
import { PAGE_LANGS, TOS_LAST_UPDATED, siteMeta } from "@/lib/seo/site-meta";
import { termsText } from "@/lib/site/terms";

// The language the middleware resolved from the address: ?lang=<code>, English at the bare path
// (src/lib/seo/lang-urls.ts; a visitor who prefers another language is redirected there).
const lang = Astro.locals.lang ?? "en";
const meta = siteMeta("tos", lang);

// Also the sitemap's lastmod for this page.
const LAST_UPDATED = TOS_LAST_UPDATED;

const t = termsText(lang);
---

<CosmosLayout title={meta.title} lang={lang} description={meta.description} langs={PAGE_LANGS.tos} breadcrumb={["home", "tos"]}>
  <main class="tos-wrap">
    <article class="tos">
      <h1>{t.title}</h1>
      <p class="tos-date">{t.updated}: {LAST_UPDATED}</p>
      <p class="tos-intro">{t.intro}</p>
      {t.sections.map((s) => (
        <section>
          <h2>{s.h}</h2>
          {s.ps.map((p) => <p>{p}</p>)}
        </section>
      ))}
    </article>
  </main>
</CosmosLayout>

<style>
  .tos-wrap {
    display: flex;
    justify-content: center;
    padding: 56px 20px 90px;
  }
  .tos {
    width: 100%;
    max-width: 760px;
  }
  .tos h1 {
    font-size: clamp(28px, 4.5vw, 38px);
    margin: 0 0 6px;
  }
  .tos-date {
    opacity: 0.55;
    font-size: 13.5px;
    margin: 0 0 22px;
  }
  .tos-intro {
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.85;
    margin-bottom: 30px;
  }
  .tos h2 {
    font-size: 19px;
    margin: 28px 0 10px;
  }
  .tos p {
    line-height: 1.7;
    font-size: 15px;
    opacity: 0.82;
    margin: 0 0 12px;
  }
</style>
