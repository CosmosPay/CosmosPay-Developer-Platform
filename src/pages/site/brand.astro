---
/* /brand on cosmospay.lat: everything needed to name and show Cosmos Pay correctly (press,
 * partners, integrators, directories). Only what the repository holds and states:
 *   - the files: public/brand and public/fonts, listed in src/lib/site/brand.ts with every file
 *     each one downloads as; the black SVGs, the PNGs of the logos and the brand kit are made from
 *     them before the build (src/lib/site/brand-kit.ts, npm run brand:build);
 *   - the rules: BRAND.md (the palette, section 3; the astronaut, section 5; the logo, section 6);
 *   - the colours: the `--cosmos-*` tokens of src/styles/cosmos.css, which the swatches paint with;
 *   - the typeface: the WOFF2 files' own name tables (designer, licence, project), and its desktop
 *     files with their licence, the project's own at a pinned commit (public/brand/fonts);
 *   - how the name is written: the catalogs and the Organization's JSON-LD ("Cosmos Pay", with
 *     "CosmosPay" its handle on GitHub and X). Press and directories copy from this page, so it
 *     never carries the About page's line about the Cosmos Network (about.disambiguation);
 *   - the contact address: CONTACT_ADDRESS, as on /about.
 * Server-rendered in the visitor's language (the `brand` block of the platform catalogs); a
 * language picked in the nav reloads it. Its JSON-LD is a WebPage about the shared Organization,
 * with its breadcrumb. Its Markdown version is src/lib/seo/site-markdown.ts (`brand`). */
import CosmosLayout from "@/layouts/CosmosLayout.astro";
import SiteFooter from "@/components/cosmos/layout/SiteFooter";
import { messages } from "@/lib/i18n/messages/index";
import { siteMeta } from "@/lib/seo/site-meta";
import { ORGANIZATION_ID } from "@/lib/seo/org";
import { GITHUB_ORG } from "@/lib/seo/schema";
import { CONTACT_ADDRESS } from "@/lib/payments/contact";
import { PAYMENTS, SITE, SOCIAL, langHref } from "@/components/cosmos/lib/constants";
import {
  ALL_POSES,
  BRAND_COLOURS,
  BRAND_LOGOS,
  BRAND_POSES,
  CHARACTER_MIN_PX,
  CLEAR_SPACE,
  FONT_FILES,
  FONT_LICENCE,
  ISOTYPE_MIN_PX,
  KIT_ZIP,
  LOGO_DONTS,
  PALETTE,
  PHONES,
  POSE_STYLES,
  RIBBON,
  SPECIMEN,
  STROKES,
  TYPEFACE,
  fileName,
  logoVariant,
  rgbText,
  type Download,
} from "@/lib/site/brand";

const lang = Astro.locals.lang ?? "en";
const catalog = (messages as Record<string, typeof messages.en>)[lang] ?? messages.en;
const t = catalog.brand;
const meta = siteMeta("brand", lang);

/** `{name}` placeholders filled, as the catalogs write them. */
const fill = (text: string, vars: Record<string, string | number>): string => text.replace(/\{(\w+)\}/g, (m, k: string) => (k in vars ? String(vars[k]) : m));
/** A file's accessible name as a download: "Download Cosmos Pay logo, black (SVG)". */
const downloadLabel = (name: string, d: Download): string => fill(t.downloadLabel, { name, format: d.format.toUpperCase() });

// The kit's size, from the build's manifest (scripts/build-brand-kit.mjs); a dev server that never
// built the kit shows the button without it.
const KIT_META = import.meta.glob<{ zipBytes: number }>("/src/assets/brand-kit.json", { eager: true, import: "default" });
const kitBytes = Object.values(KIT_META)[0]?.zipBytes;
const kitSize = kitBytes
  ? fill(t.kitSize, { size: new Intl.NumberFormat(lang, { style: "unit", unit: "megabyte", maximumFractionDigits: 1 }).format(kitBytes / 1e6) })
  : null;
const KIT_NAME = KIT_ZIP.slice(KIT_ZIP.lastIndexOf("/") + 1);

const MAILTO = `mailto:${CONTACT_ADDRESS}`;
const PAYMENTS_HOST = new URL(PAYMENTS).host;

/* The clear-space drawing, in the logo file's own units (CLEAR_SPACE): the zone is the artwork's
   box grown by the c on every side, and a c-sized square marks it on each side. */
const { art, c, viewBox: vb } = CLEAR_SPACE;
const ZONE = { x: art.x - c, y: art.y - c, w: art.w + 2 * c, h: art.h + 2 * c };
const PAD = 6;
const SPACE_VIEWBOX = [ZONE.x - PAD, ZONE.y - PAD, ZONE.w + 2 * PAD, ZONE.h + 2 * PAD].map((n) => n.toFixed(2)).join(" ");
const UNITS = [
  { x: art.x + art.w / 2 - c / 2, y: art.y - c },
  { x: art.x + art.w / 2 - c / 2, y: art.y + art.h },
  { x: art.x - c, y: art.y + art.h / 2 - c / 2 },
  { x: art.x + art.w, y: art.y + art.h / 2 - c / 2 },
];
const MIN_STEPS = [ISOTYPE_MIN_PX * 4, ISOTYPE_MIN_PX * 2, ISOTYPE_MIN_PX];

/* A download glyph (the arrow into a tray), 1.5px line as the brand's icons. */
const DOWNLOAD_ICON = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 19h14"/></svg>`;
---

<CosmosLayout
  title={meta.title}
  description={meta.description}
  lang={lang}
  breadcrumb={["home", "brand"]}
  about={ORGANIZATION_ID}
  navOverPanel="black"
  reloadOnLang
>
  <main id="main" class="brand-page">
    <section class="lp-panel brand-hero" data-panel="black" aria-labelledby="brand-title">
      <div class="wrap">
        <div class="brand-hero-grid">
          <div>
            <h1 id="brand-title" data-num="/01">{t.title}</h1>
            <p class="brand-lede">{t.lede}</p>
            <div class="brand-row">
              <a class="btn btn-white" href={KIT_ZIP} download={KIT_NAME}><Fragment set:html={DOWNLOAD_ICON} />{t.download}</a>
              {kitSize && <span class="brand-meta">{kitSize}</span>}
            </div>
          </div>
          <img class="brand-hero-mark" src="/brand/isotipo.svg" alt="" width="320" height="320" fetchpriority="high" />
        </div>
        <dl class="brand-facts">
          <div><dt>{t.facts.logos}</dt><dd>{fill(t.facts.logosValue, { n: BRAND_LOGOS.length })}</dd></div>
          <div><dt>{t.facts.colours}</dt><dd>{fill(t.facts.coloursValue, { n: BRAND_COLOURS.length })}</dd></div>
          <div><dt>{t.facts.typeface}</dt><dd translate="no">{TYPEFACE.family}</dd></div>
          <div><dt>{t.facts.illustrations}</dt><dd>{fill(t.facts.illustrationsValue, { n: BRAND_POSES.length, styles: POSE_STYLES.length })}</dd></div>
        </dl>
      </div>
    </section>

    <section class="lp-panel brand-panel" data-panel="white" aria-labelledby="brand-name">
      <div class="wrap">
        <div class="section-head brand-head">
          <h2 id="brand-name" data-num="/02">{t.name.title}</h2>
          <p>{t.name.lede}</p>
        </div>
        <dl class="brand-names">
          <div>
            <dt translate="no">Cosmos Pay</dt>
            <dd>{t.name.items.company}</dd>
          </div>
          <div>
            <dt translate="no">Cosmos Pay Payments</dt>
            <dd>{t.name.items.payments} <a class="brand-link" href={langHref(PAYMENTS, lang, "site")} translate="no">{PAYMENTS_HOST}</a></dd>
          </div>
          <div>
            <dt translate="no">Cosmos Pay Wallet</dt>
            <dd>{t.name.items.wallet} <a class="brand-link" href={langHref(`${SITE}/#wallet`, lang, "site")}>{t.name.walletLink}</a></dd>
          </div>
          <div class="brand-handle">
            <dt translate="no">CosmosPay</dt>
            <dd>{t.name.items.handle} <a class="brand-link" href={GITHUB_ORG} rel="noopener">GitHub</a> <a class="brand-link" href={SOCIAL.x} rel="noopener">X</a></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="lp-panel brand-panel" data-panel="black" aria-labelledby="brand-logo">
      <div class="wrap">
        <div class="section-head brand-head">
          <h2 id="brand-logo" data-num="/03">{t.logo.title}</h2>
          <p>{t.logo.lede}</p>
        </div>
        <ul class="brand-logos" role="list">
          {BRAND_LOGOS.map((logo) => {
            const item = t.logo.items[logo.key];
            return (
              <li class={`brand-logo is-${logo.key}`} style={`--variants: ${logo.variants.length}`}>
                <h3>{item.t}</h3>
                <p>{item.d}</p>
                <div class="brand-variants">
                  {logo.variants.map(({ ink, svg, png }) => {
                    const name = fill(t.logo.fileName, { logo: item.t, ink: t.logo.inks[ink] });
                    return (
                      <div class="brand-variant">
                        {/* White ink on navy, black and Cosmic Blue on white. */}
                        <div class={`brand-tile ${ink === "white" ? "on-navy" : "on-white"} is-${logo.key}`}>
                          <img src={svg.href} alt={name} loading="lazy" decoding="async" />
                        </div>
                        <div class="brand-dl">
                          {[svg, png].map((d) => (
                            <a class="btn btn-outline-w btn-sm" href={d.href} download={fileName(d)} aria-label={downloadLabel(name, d)}>
                              <Fragment set:html={DOWNLOAD_ICON} />
                              {d.format.toUpperCase()}
                            </a>
                          ))}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </li>
            );
          })}
        </ul>

        <div class="brand-rules">
          <div class="brand-rule brand-space">
            <h3>{t.logo.space.t}</h3>
            <p>{t.logo.space.d}</p>
            <svg class="brand-space-art" viewBox={SPACE_VIEWBOX} role="img" aria-label={t.logo.space.d}>
              <rect class="zone" x={ZONE.x} y={ZONE.y} width={ZONE.w} height={ZONE.h} />
              <rect class="art" x={art.x} y={art.y} width={art.w} height={art.h} />
              <image href="/brand/lockup-cosmos-pay.svg" x={vb.x} y={vb.y} width={vb.w} height={vb.h} />
              {UNITS.map((u) => (
                <g class="unit">
                  <rect x={u.x} y={u.y} width={c} height={c} />
                  <text x={u.x + c / 2} y={u.y + c / 2} dominant-baseline="central" text-anchor="middle">c</text>
                </g>
              ))}
            </svg>
          </div>
          <div class="brand-rule brand-min">
            <h3>{t.logo.minimum.t}</h3>
            <p>{fill(t.logo.minimum.d, { n: ISOTYPE_MIN_PX })}</p>
            <div class="brand-min-steps">
              {MIN_STEPS.map((size, i) => (
                <div class="brand-min-step">
                  <img src="/brand/isotipo.svg" alt="" width={size} height={size} loading="lazy" />
                  {i === MIN_STEPS.length - 1 && <span>{fill(t.logo.minimum.value, { n: ISOTYPE_MIN_PX })}</span>}
                </div>
              ))}
            </div>
          </div>
        </div>

        <h3 class="brand-sub">{t.logo.donts.t}</h3>
        <ul class="brand-donts" role="list">
          {LOGO_DONTS.map((key) => (
            <li class={`brand-dont is-${key}`}>
              <div class="brand-dont-tile" aria-hidden="true">
                {key === "recolour" ? <span class="brand-dont-mask" /> : <img src={key === "busy" ? "/brand/lockup-cosmos-pay.svg" : logoVariant(BRAND_LOGOS[0], "black").svg.href} alt="" loading="lazy" />}
              </div>
              <p>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="9" /><path d="m6.5 6.5 7 7M13.5 6.5l-7 7" /></svg>
                {t.logo.donts.items[key]}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="lp-panel brand-panel" data-panel="white" aria-labelledby="brand-colour">
      <div class="wrap">
        <div class="section-head brand-head">
          <h2 id="brand-colour" data-num="/04">{t.colour.title}</h2>
          <p>{t.colour.lede}</p>
        </div>
        <ul class="brand-swatches" role="list">
          {BRAND_COLOURS.map((colour) => {
            const rgb = rgbText(colour.hex);
            return (
              <li class="brand-swatch">
                <div class={`brand-chip is-${colour.key}`} aria-hidden="true" />
                <h3 translate="no">{colour.name}</h3>
                <p>{t.colour.roles[colour.key]}</p>
                <dl class="brand-values">
                  {[
                    { label: t.colour.hex, value: colour.hex },
                    { label: t.colour.rgb, value: rgb },
                  ].map((v) => (
                    <div>
                      <dt>{v.label}</dt>
                      <dd>
                        <button type="button" class="brand-copy" data-copy={v.value} data-done={fill(t.colour.copied, { value: v.value })} aria-label={fill(t.colour.copy, { value: v.value })} translate="no">
                          <span>{v.value}</span>
                          <svg class="i-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5" /><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8" /></svg>
                          <svg class="i-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                        </button>
                      </dd>
                    </div>
                  ))}
                </dl>
              </li>
            );
          })}
        </ul>
        <div class="brand-row">
          <a class="btn btn-ghost-pill" href={PALETTE.href} download={fileName(PALETTE)}><Fragment set:html={DOWNLOAD_ICON} />{t.colour.palette}</a>
        </div>
        <p class="brand-sr" id="brand-copied" role="status" aria-live="polite"></p>
      </div>
    </section>

    <section class="lp-panel brand-panel" data-panel="black" aria-labelledby="brand-type">
      <div class="wrap">
        <div class="section-head brand-head">
          <h2 id="brand-type" data-num="/05">{t.type.title}</h2>
          <p>{fill(t.type.lede, { n: TYPEFACE.weights.length })}</p>
        </div>
        <div class="brand-type">
          <div class="brand-type-aa" aria-hidden="true" translate="no">Aa</div>
          <div class="brand-type-side">
            {/* Each weight with its desktop file (TTF), and the licence they travel with. */}
            <ul class="brand-weights" role="list">
              {TYPEFACE.weights.map((w) => {
                const d = FONT_FILES.find((f) => f.href === w.desktop)!;
                return (
                  <li class={`w-${w.weight}`}>
                    <span class="name" translate="no">{TYPEFACE.family} {w.name}</span>
                    <span class="num">{w.weight}</span>
                    <a class="btn btn-outline-w btn-sm" href={d.href} download={fileName(d)} aria-label={downloadLabel(`${TYPEFACE.family} ${w.name}`, d)}>
                      <Fragment set:html={DOWNLOAD_ICON} />
                      TTF
                    </a>
                  </li>
                );
              })}
            </ul>
            <div class="brand-dl brand-type-licence">
              <a class="btn btn-outline-w btn-sm" href={FONT_LICENCE.href} download={fileName(FONT_LICENCE)}><Fragment set:html={DOWNLOAD_ICON} />{t.type.licenceFile}</a>
            </div>
            <p class="brand-specimen" translate="no">
              {SPECIMEN.map((line) => <span>{line}</span>)}
            </p>
            <dl class="brand-type-facts">
              <div><dt>{t.type.designer}</dt><dd translate="no">{TYPEFACE.designer}</dd></div>
              <div><dt>{t.type.licence}</dt><dd translate="no">{TYPEFACE.licenceName}</dd></div>
            </dl>
            <div class="brand-row">
              <a class="btn btn-white" href={TYPEFACE.source} rel="noopener">{t.type.source}</a>
              <a class="btn btn-outline-w" href={TYPEFACE.licence} rel="noopener">{t.type.readLicence}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-panel brand-panel" data-panel="white" aria-labelledby="brand-astronaut">
      <div class="wrap">
        <div class="section-head brand-head">
          <h2 id="brand-astronaut" data-num="/06">{t.illustrations.title}</h2>
          <p>{fill(t.illustrations.lede, { n: BRAND_POSES.length })}</p>
        </div>
        <ul class="brand-legend" role="list">
          {POSE_STYLES.map((style) => <li><span class={`dot is-${style}`} aria-hidden="true" />{t.illustrations.styles[style]}</li>)}
        </ul>
        <ul class="brand-poses" role="list">
          {BRAND_POSES.map((pose) => {
            const name = t.illustrations.poses[pose.key];
            return (
              <li class="brand-pose">
                <h3>{name}</h3>
                <div class="brand-pose-styles">
                  {POSE_STYLES.map((style) => {
                    const d = pose.png[style];
                    return (
                      <a class={`brand-pose-tile is-${style}`} href={d.href} download={fileName(d)} aria-label={downloadLabel(fill(t.illustrations.fileName, { pose: name, style: t.illustrations.styles[style] }), d)}>
                        <img src={d.href} alt="" width="1081" height="1081" loading="lazy" decoding="async" />
                        <span class="brand-pose-get" aria-hidden="true"><Fragment set:html={DOWNLOAD_ICON} /></span>
                      </a>
                    );
                  })}
                </div>
                <a class="btn btn-ghost-pill btn-sm" href={pose.svg.href} download={fileName(pose.svg)} aria-label={downloadLabel(name, pose.svg)}><Fragment set:html={DOWNLOAD_ICON} />SVG</a>
              </li>
            );
          })}
          <li class="brand-pose brand-pose-all">
            <h3>{t.illustrations.all.t}</h3>
            <a class="btn btn-ghost-pill" href={ALL_POSES.href} download={fileName(ALL_POSES)}><Fragment set:html={DOWNLOAD_ICON} />{t.illustrations.all.a}</a>
          </li>
          <li class="brand-pose brand-pose-rules">
            <h3>{t.illustrations.rules.t}</h3>
            <ul role="list">
              <li>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18M8 6l4-3 4 3M8 18l4 3 4-3" /></svg>
                {fill(t.illustrations.rules.size, { n: CHARACTER_MIN_PX })}
              </li>
              <li>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
                {t.illustrations.rules.one}
              </li>
              <li>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="4" /><circle cx="16" cy="8" r="4" /><circle cx="8" cy="16" r="4" /><circle cx="16" cy="16" r="4" /></svg>
                {t.illustrations.rules.colours}
              </li>
            </ul>
          </li>
        </ul>

        <h3 class="brand-sub">{t.illustrations.phones.t}</h3>
        <ul class="brand-phones" role="list">
          {PHONES.map((phone) => {
            const style = t.illustrations.phones.styles[phone.key];
            const name = fill(t.illustrations.fileName, { pose: t.illustrations.poses.phone, style });
            return (
              <li class="brand-phone">
                {/* A drawing with a white outline is shown on navy, where the outline reads. */}
                <div class={`brand-phone-tile on-${phone.ground}`}>
                  <img src={phone.svg.href} alt="" width="1080" height="1080" loading="lazy" decoding="async" />
                </div>
                <p>{style}</p>
                <div class="brand-dl">
                  {[phone.svg, phone.png].map((d) => (
                    <a class="btn btn-ghost-pill btn-sm" href={d.href} download={fileName(d)} aria-label={downloadLabel(name, d)}>
                      <Fragment set:html={DOWNLOAD_ICON} />
                      {d.format.toUpperCase()}
                    </a>
                  ))}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section class="lp-panel brand-panel" data-panel="black" aria-labelledby="brand-graphics">
      <div class="wrap">
        <div class="section-head brand-head">
          <h2 id="brand-graphics" data-num="/07">{t.graphics.title}</h2>
          <p>{t.graphics.lede}</p>
        </div>
        <div class="brand-graphics">
          <div class="brand-ribbon">
            <h3>{t.graphics.ribbon}</h3>
            <div class="brand-ribbon-frame">
              <img src={RIBBON.view} alt="" width={RIBBON.width} height={RIBBON.height} loading="lazy" decoding="async" />
            </div>
            <div class="brand-dl">
              <a class="btn btn-outline-w btn-sm" href={RIBBON.download.href} download={fileName(RIBBON.download)} aria-label={downloadLabel(t.graphics.ribbon, RIBBON.download)}><Fragment set:html={DOWNLOAD_ICON} />PNG</a>
            </div>
          </div>
          <div class="brand-strokes-wrap">
            <h3>{t.graphics.strokes}</h3>
            <ul class="brand-strokes" role="list">
              {STROKES.map((stroke) => (
                <li>
                  <a class="brand-stroke" href={stroke.download.href} download={fileName(stroke.download)} aria-label={downloadLabel(fill(t.graphics.stroke, { n: stroke.n }), stroke.download)}>
                    <span class={`brand-stroke-art s-${stroke.n}`} aria-hidden="true" />
                    <span class="brand-pose-get" aria-hidden="true"><Fragment set:html={DOWNLOAD_ICON} /></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-panel cta" data-panel="navy" aria-labelledby="brand-usage">
      <div class="wrap">
        <div class="cta-panel">
          <h2 id="brand-usage" data-num="/08">{t.usage.title}</h2>
          <p>{t.usage.lede}</p>
          <p>{t.usage.contact}</p>
          <div class="row">
            <a class="btn btn-white" href={KIT_ZIP} download={KIT_NAME}><Fragment set:html={DOWNLOAD_ICON} />{t.download}</a>
            <a class="btn btn-outline-w" href={MAILTO} translate="no">{CONTACT_ADDRESS}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} area="site" />
</CosmosLayout>

<script>
  /* The swatches' values copy on a click: the clipboard (or, where it is refused, a selected
     field and the copy command), the button's mark turns to a check for a moment, and the status
     line says what was copied. */
  const live = document.getElementById("brand-copied");
  async function copy(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = document.createElement("textarea");
      field.value = text;
      field.setAttribute("readonly", "");
      field.style.position = "fixed";
      field.style.opacity = "0";
      document.body.append(field);
      field.select();
      const done = document.execCommand("copy");
      field.remove();
      return done;
    }
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    let timer: number | undefined;
    button.addEventListener("click", async () => {
      if (!(await copy(button.dataset.copy ?? ""))) return;
      button.dataset.state = "done";
      if (live) live.textContent = button.dataset.done ?? "";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => delete button.dataset.state, 1600);
    });
  }
