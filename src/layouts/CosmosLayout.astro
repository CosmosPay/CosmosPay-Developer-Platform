---
import { messages } from "@/lib/i18n/messages/index";
import "@/styles/cosmos.css";
import "@/styles/views.css";
import "@/styles/onboarding.css";
import "@/styles/institutional.css";
import { PUBLIC_GA_ID, PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { DEV, PAYMENTS, SITE, SOCIAL } from "@/components/cosmos/lib/constants";
import SiteNav from "@/components/cosmos/layout/SiteNav";
import BackToTop from "@/components/cosmos/layout/BackToTop.astro";
import StructuredData from "@/components/site/StructuredData.astro";
import { SITE_LANGS, SITE_PAGE_PATHS, crumbName, type SitePage } from "@/lib/seo/site-meta";
import { DEFAULT_LANG, canonicalUrl, explicitLang, hreflangAlternates, ogLocale, pageLanguages } from "@/lib/seo/lang-urls";
import { crossHostCanonical } from "@/lib/seo/cross-host";
import { markdownAlternate } from "@/lib/seo/markdown-urls";
import { modifiedAt } from "@/lib/seo/page-dates-build";
import { pageShareImage, type ShareImage } from "@/lib/seo/og-image-urls";
import type { JsonLdNode } from "@/lib/seo/schema";
import { analyticsEnabled, analyticsSnippet } from "@/lib/analytics";

interface Props {
  title?: string;
  lang?: string;
  description?: string;
  /** OG/Twitter share image (absolute path under /public), 1200x630 PNG. Without it, an indexable
   *  page of the company site names its own card (src/lib/seo/og-images.ts) and every other page
   *  the brand card. */
  image?: string;
  /** Set true on private/auth pages so search engines don't index them. */
  noindex?: boolean;
  /** Open Graph type: "website" for marketing pages, "article" for posts. */
  type?: string;
  /** The page's largest image above the fold (its LCP element), fetched at high priority before
   *  the body is parsed. `dark` is the one the dark theme shows instead, when they differ; only
   *  the theme's own image is requested. */
  preloadImage?: { light: string; dark?: string };
  /** Company site: the languages the page's own text is written in (its hreflang versions).
   *  Every site language by default; /tos exists in English and Spanish only. */
  langs?: readonly string[];
  /** Company site: the pages of the breadcrumb trail, ending at this one (JSON-LD BreadcrumbList). */
  breadcrumb?: SitePage[];
  /** Company site: what the page is mainly about (the @id of a node in `schema`, or the shared
   *  Organization's). */
  mainEntity?: string;
  /** Company site: the page's schema.org type when it is more specific than WebPage ("AboutPage"). */
  pageType?: string;
  /** Company site: nodes this page adds to its JSON-LD graph (src/lib/seo/schema.ts). */
  schema?: JsonLdNode[];
  /** The general nav bar, on every view. Off only where the page's own React tree renders
   *  <Nav> (Landing, Pricing, Dashboard), so it is never drawn twice. */
  nav?: boolean;
  /** The nav starts transparent with light ink over the page's first panel when it is dark
   *  (`<main>`'s first `section[data-panel]`), as on /pricing. */
  navOverPanel?: "black" | "white";
  /** The page's copy is rendered on the server: a language picked in the nav reloads the page in
   *  it (an island re-renders by itself; server-rendered text does not). */
  reloadOnLang?: boolean;
  /** A skin class for <body>; "inst" puts the page on the institutional skin (the dashboard). */
  bodyClass?: string;
}

const {
  title = "Cosmos Pay Developer Platform",
  lang,
  description = "The Cosmos Pay developer dashboard: sign in, manage your organization, mint API keys, and operate the Cosmos Pay Payments API (multi-chain payment intents on Stellar, Solana and Monad, swaps, webhooks, products, customers and analytics).",
  image,
  noindex = false,
  type = "website",
  preloadImage,
  nav = true,
  navOverPanel,
  reloadOnLang = false,
  bodyClass,
  langs = SITE_LANGS,
  breadcrumb,
  mainEntity,
  pageType,
  schema = [],
} = Astro.props;

// The language: the page's own, else the middleware's (on the company site, ?lang=; its bare path
// is English), else the cookie the in-app language switcher sets, so SSR and the first client
// render agree. Defaults to English.
const locale = lang ?? Astro.locals.lang ?? Astro.cookies.get("cosmospay-lang")?.value ?? "en";
const skipLabel = ((messages as Record<string, typeof messages.en>)[locale] ?? messages.en).ui.skipToContent;

// Absolute URLs for canonical + social cards, on the domain this page is served as and at
// its public path: the company pages render from /site/* behind a rewrite (src/lib/hosts.ts).
const areaOrigin = { site: SITE, dev: DEV, payments: PAYMENTS }[Astro.locals.area ?? "dev"];
const siteBase = new URL(areaOrigin || Astro.site || "https://dev.cosmospay.lat");
const path = Astro.locals.publicPath ?? Astro.url.pathname;
// The company site has one address per language, like the gateway (src/lib/seo/lang-urls.ts):
// English at the bare path (also x-default), the others at ?lang=<code>. Each version names
// itself canonical and lists the others, so search engines index every language. A page whose
// canonical version is the gateway's (/swaps: src/lib/seo/cross-host.ts) names that one instead
// and lists no versions of its own.
const multilingual = Astro.locals.area === "site" && !noindex;
const asked = explicitLang(Astro.url.searchParams.get("lang"), SITE_LANGS);
const self = multilingual ? canonicalUrl(SITE, path, asked, langs, SITE_LANGS) : new URL(path, siteBase).href;
const elsewhere = multilingual ? crossHostCanonical(path, asked, langs, SITE_LANGS, PAYMENTS) : null;
const canonical = elsewhere ?? self;
const alternates = multilingual && !elsewhere && langs.length > 1 ? hreflangAlternates(SITE, path, langs) : [];
// The Markdown version of the version shown (src/lib/seo/markdown-urls.ts): its canonical address
// with .md, so /tos?lang=fr names the English terms' and /swaps the gateway's, where its canonical is.
const markdown = multilingual && pageLanguages("site", path.toLowerCase()) !== undefined ? markdownAlternate(canonical) : null;
// The language the page's text is in: a /tos version in a language it is not written in shows English.
const contentLang = langs.includes(locale) ? locale : (langs[0] ?? "en");
// The trail in the version's language, each step at its address in that language (the page's own
// address last, whichever host is canonical).
const crumbs = (breadcrumb ?? []).map((page, i, all) => ({
  name: crumbName(page, contentLang),
  url: i === all.length - 1 ? self : canonicalUrl(SITE, SITE_PAGE_PATHS[page], asked, SITE_LANGS),
}));
// When the page last changed: the date it states, else its sources' last commit (page-dates.ts).
const dateModified = multilingual ? modifiedAt("site", path, contentLang) : null;
// The share image: a page's own `image`, else the card of the page in the language shown (the
// gateway's card where the gateway's page is the canonical one: /swaps), else the brand card.
const card = multilingual
  ? elsewhere
    ? pageShareImage("payments", new URL(elsewhere).pathname, contentLang, PAYMENTS)
    : pageShareImage("site", path, contentLang, SITE)
  : null;
const share: ShareImage =
  (!image && card) || { url: new URL(image ?? "/og-image.png", siteBase).href, type: "image/png", width: 1200, height: 630, alt: "Cosmos Pay" };
const robots = noindex ? "noindex, nofollow" : "index, follow";
// Google Analytics only on the company site's indexable pages, never on the platform (the dashboard,
// invitations and KYC returns carry tokens and searches in their addresses): src/lib/analytics.ts.
const analytics = analyticsEnabled({ gaId: PUBLIC_GA_ID, area: Astro.locals.area, path, noindex }) ? analyticsSnippet(PUBLIC_GA_ID) : null;
const googleSiteVerification = PUBLIC_GOOGLE_SITE_VERIFICATION;
const xHandle = `@${new URL(SOCIAL.x).pathname.split("/").filter(Boolean)[0]}`;

// The theme is applied before paint (default light); then the LCP image of that theme is
// requested at once, at high priority, instead of when the parser reaches its <img>. On the
// company site, a language picked in the nav (setLang changes <html lang> without a reload) also
// becomes the address: ?lang=<code>, or the bare path for English, so a reload or a shared link
// keeps it (SiteNav does the same with langSearch for the pages that reload).
const lcp = preloadImage ? JSON.stringify(preloadImage).replace(/</g, "\\u003c") : "";
const themeScript =
  `(function(){var d=document.documentElement,t;try{t=localStorage.getItem("cosmospay-theme")||"light"}catch(e){t="light"}` +
  `d.setAttribute("data-theme",t);` +
  (lcp
    ? `var s=${lcp},l=document.createElement("link");l.rel="preload";l.as="image";` +
      `l.href=(t==="dark"&&s.dark)||s.light;l.setAttribute("fetchpriority","high");document.head.appendChild(l);`
    : "") +
  (multilingual
    ? `if(window.MutationObserver&&window.URL)new MutationObserver(function(){var u=new URL(location.href),q=u.searchParams.get("lang"),l=d.lang,e=l===${JSON.stringify(DEFAULT_LANG)};` +
      `if(l&&(e?q!==null:q!==l)){if(e)u.searchParams.delete("lang");else u.searchParams.set("lang",l);history.replaceState(history.state,"",u.href)}}).observe(d,{attributes:true,attributeFilter:["lang"]});`
    : "") +
  `})();`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta name="generator" content={Astro.generator} />

    <!-- Icons / PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFFFF" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Cosmos Pay" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={share.url} />
    <meta property="og:image:type" content={share.type} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />
    <meta property="og:locale" content={ogLocale(contentLang)} />
    {multilingual && langs.filter((l) => l !== contentLang).map((l) => <meta property="og:locale:alternate" content={ogLocale(l)} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={share.url} />
    <meta name="twitter:image:alt" content={share.alt} />

    <!-- The page's JSON-LD graph (company site; the platform's pages are not indexed). -->
    {multilingual && (
      <StructuredData
        url={self}
        title={title}
        description={description}
        lang={contentLang}
        image={share}
        breadcrumb={crumbs}
        mainEntity={mainEntity}
        pageType={pageType}
        schema={schema}
        dateModified={dateModified}
      />
    )}

    <!-- Tipografia de marca (Open Sauce One) servida desde /public/fonts; el @font-face
         vive en cosmos.css. Se precarga el peso Regular, que esta en todas las paginas. -->
    <link rel="preload" href="/fonts/OpenSauceOne-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Light es el peso de todos los titulares; sin preload el h1 salta al llegar la fuente. -->
    <link rel="preload" href="/fonts/OpenSauceOne-Light.woff2" as="font" type="font/woff2" crossorigin />
    <!-- The persisted theme before paint (no flash), then the page's LCP image for that theme. -->
    <script is:inline set:html={themeScript} />

    {/* Google Analytics, on the company site's indexable pages only (src/lib/analytics.ts): the
        queue starts now (the page view keeps its time) with the address stripped of every query
        parameter but lang, and gtag.js (about 150 KB) is fetched once the page has loaded and the
        browser is idle, so it never competes with the first screen nor runs during it. */}
    {analytics && <script is:inline set:html={analytics} />}
    <style>
      /* Keyboard skip-to-content link, visually hidden until focused. */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 1000;
        padding: 10px 16px;
        background: var(--accent, #000877);
        color: var(--accent-fg, #fff);
        font: 600 14px/1 var(--ff-sans, 'Open Sauce One', system-ui, sans-serif);
        border-radius: 0 0 12px 0;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{skipLabel}</a>
    {nav && (
      <SiteNav
        client:load
        lang={locale}
        user={Astro.locals.user ? { name: Astro.locals.user.name, email: Astro.locals.user.email, image: Astro.locals.user.image } : null}
        session={Astro.locals.area !== "payments"}
        area={Astro.locals.area === "site" ? "site" : undefined}
        overPanel={navOverPanel}
        reloadOnLang={reloadOnLang}
      />
    )}
    <slot />

    <script>
      // The snap's ink fill on every button (src/scripts/ink.ts).
      import { installInk } from "@/scripts/ink";

      installInk();
    </script>
    <BackToTop lang={locale} />
  </body>
</html>
