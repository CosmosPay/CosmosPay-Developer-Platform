{
  "name": "paydev",
  "type": "module",
  "version": "0.1.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "prisma migrate deploy && node scripts/ensure-docs.mjs",
    "dev": "astro dev --host",
    "build": "prisma generate && npm run docs:build && astro build",
    "docs:build": "node scripts/build-docs.mjs",
    "prestart": "node scripts/ensure-docs.mjs",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "sync:route": "node scripts/sync-apisix-route.mjs",
    "test:unit": "node --disable-warning=ExperimentalWarning --disable-warning=DEP0205 --experimental-strip-types --import ./tests/setup.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:smoke": "node scripts/smoke-server.mjs",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "axios": "^1.20.0",
    "better-auth": "^1.7.3",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "maxmind": "^5.0.7",
    "nodemailer": "^10.0.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
