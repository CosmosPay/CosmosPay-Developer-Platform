{
  "name": "paydev",
  "type": "module",
  "version": "0.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "prisma migrate deploy && node scripts/ensure-docs.mjs",
    "dev": "astro dev --host",
    "build": "prisma generate && npm run docs:build && astro build",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:api": "npm run generate:api --prefix docs && npm run apply:i18n --prefix docs",
    "check:api-spec": "node scripts/check-api-spec.mjs",
    "prestart": "node scripts/ensure-docs.mjs",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "sync:route": "node scripts/sync-apisix-route.mjs",
    "export:wallet-data": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/export-wallet-data.mjs",
    "test:unit": "node --disable-warning=ExperimentalWarning --disable-warning=DEP0205 --experimental-strip-types --import ./tests/setup.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:smoke": "node scripts/smoke-server.mjs",
    "check:openapi": "node --disable-warning=ExperimentalWarning --disable-warning=DEP0205 --experimental-strip-types --import ./tests/setup.mjs scripts/check-openapi-coverage.mjs",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "axios": "^1.20.0",
    "better-auth": "^1.7.8",
    "dotenv": "^18.0.8",
    "gsap": "^3.15.0",
    "maxmind": "^5.0.7",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
