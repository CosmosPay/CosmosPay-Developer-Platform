{
  "name": "paydev",
  "type": "module",
  "version": "0.1.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "prisma migrate deploy && node scripts/ensure-docs.mjs",
    "dev": "astro dev --host",
    "build": "prisma generate && npm run docs:build && astro build",
    "docs:build": "node scripts/build-docs.mjs",
    "prestart": "node scripts/ensure-docs.mjs",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "sync:route": "node scripts/sync-apisix-route.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.0.7",
    "axios": "^1.20.0",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "maxmind": "^5.0.7",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "@hono/node-server": "^1.19.14"
  }
}
